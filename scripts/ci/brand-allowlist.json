{
    "version":  1,
    "rules":  [
                  {
                      "path":  "legal/**",
                      "patterns":  [
                                       "Spree",
                                       "SPREE",
                                       "spree",
                                       "@spree/",
                                       "X-Spree"
                                   ],
                      "category":  "provenance",
                      "reason":  "Original upstream names are legally required in source provenance and attribution records."
                  },
                  {
                      "path":  "**/LICENSE*",
                      "patterns":  [
                                       "Spree",
                                       "SPREE",
                                       "spree"
                                   ],
                      "category":  "license",
                      "reason":  "Third-party copyright and license notices must remain verbatim."
                  },
                  {
                      "path":  "**/NOTICE*",
                      "patterns":  [
                                       "Spree",
                                       "SPREE",
                                       "spree"
                                   ],
                      "category":  "license",
                      "reason":  "Third-party notice and attribution text must remain verbatim."
                  },
                  {
                      "path":  "backups/**",
                      "patterns":  [
                                       "Spree",
                                       "SPREE",
                                       "spree",
                                       "@spree/",
                                       "X-Spree"
                                   ],
                      "category":  "archive",
                      "reason":  "Historical recovery artifacts are immutable and are not distributed as active source."
                  },
                  {
                      "path":  "**/pallastrade_legacy_api_v2-1.0.0/app/controllers/concerns/pallastrade/api/v2/storefront/order_concern.rb",
                      "patterns":  [
                                       "X-Spree",
                                       "Spree"
                                   ],
                      "category":  "compatibility",
                      "reason":  "Legacy API v2 accepts the deprecated order-token header as a read-only fallback."
                  },
                  {
                      "path":  "scripts/ci/audit*.ps1",
                      "patterns":  [
                                       "Spree",
                                       "SPREE",
                                       "spree",
                                       "@spree/",
                                       "X-Spree"
                                   ],
                      "category":  "audit-tool",
                      "reason":  "Legacy audit tools must contain the forbidden tokens they search for."
                  },
                  {
                      "path":  "scripts/ci/rename-gems-safe.ps1",
