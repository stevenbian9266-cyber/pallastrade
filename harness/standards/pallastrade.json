{
  "schemaVersion": "1.0",
  "standards": [
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-ARCH-001",
      "category": "architecture",
      "title": "PallasTrade customization follows the approved extension order",
      "authority": { "file": "AGENTS.md", "section": "§3 Customization Decision Tree" },
      "scope": ["backend/**/*.rb"],
      "severity": "warning",
      "enforcement": { "level": "review-required", "type": "review", "verifier": "customization-decision" },
      "evidence": ["cross-layer-search", "customization-decision"],
      "fix": "Use settings, events, dependency injection, extensions, or generators before decorators and direct gem modification.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["domain Skill", "layer CLAUDE.md"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-TECH-001",
      "category": "technology-selection",
      "title": "New frameworks and dependencies require a technology choice record",
      "authority": { "file": "docs/standards/README.md", "section": "技术与工程规范" },
      "scope": ["package.json", "**/package.json", "backend/Gemfile", "**/Gemfile"],
      "severity": "warning",
      "enforcement": { "level": "review-required", "type": "evidence", "verifier": "technology-review" },
      "evidence": ["alternatives", "maintenance-cost", "security-review", "exit-plan"],
      "fix": "Record why existing capabilities are insufficient, evaluated alternatives, lifecycle/security cost, and exit strategy.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["architecture decision", "deployment documentation"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-CODE-001",
      "category": "code-quality",
      "title": "Search and reuse before adding an implementation",
      "authority": { "file": "AGENTS.md", "section": "§2 Step 0 and §5" },
      "scope": ["backend/**/*.{rb,erb}", "storefront/**/*.{js,jsx,ts,tsx}", "platform/**/*.{js,jsx,ts,tsx}"],
      "severity": "warning",
      "enforcement": { "level": "verified", "type": "deterministic+evidence", "verifier": "duplication-and-search" },
      "evidence": ["six-layer-search", "duplicate-block-scan"],
      "fix": "Reuse or extract the existing model, service, component, or helper; document why a new implementation is required.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["relevant domain Skill"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-DB-001",
      "category": "database",
      "title": "Database changes use new reversible migrations and preserve generated files",
      "authority": { "file": "AGENTS.md", "section": "§1 Repository Layout and §6" },
      "scope": ["backend/db/migrate/**/*.rb", "backend/db/schema.rb", "backend/app/models/**/*.rb"],
      "severity": "error",
      "enforcement": { "level": "critical", "type": "deterministic+evidence", "verifier": "migration-integrity" },
      "evidence": ["base-tree", "migration-test", "schema-generation"],
      "fix": "Create a new reversible migration, run it through Rails, and never hand-edit historical migrations or schema.rb.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["pallastrade-data-model Skill", "recovery plan"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-API-001",
      "category": "api",
      "title": "API v3 preserves tenant scope, prefixed IDs, envelopes, and generated contracts",
      "authority": { "file": "AGENTS.md", "section": "§4 API v3 Rules" },
      "scope": ["backend/**/*api/v3/**/*.rb", "backend/public/api-docs/*.yaml", "platform/packages/{sdk,admin-sdk}/**/*"],
      "severity": "error",
      "enforcement": { "level": "blocking", "type": "workflow+contract", "verifier": "api-contract" },
      "evidence": ["tenant-scope", "openapi-diff", "generated-check", "request-test"],
      "fix": "Scope through current_store, preserve API v3 envelopes and prefixed IDs, update OpenAPI, then regenerate SDK types.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["pallastrade-api-v3 Skill", "OpenAPI", "SDK reference"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-SEC-001",
      "category": "security",
      "title": "Authorization, store isolation, secrets, and dangerous operations are fail-closed",
      "authority": { "file": "AGENTS.md", "section": "§4 and §8" },
      "scope": ["backend/**/*.rb", "storefront/**/*.{js,jsx,ts,tsx}", "platform/**/*.{js,jsx,ts,tsx}", ".github/workflows/*"],
      "severity": "error",
      "enforcement": { "level": "critical", "type": "scanner+review", "verifier": "security-controls" },
      "evidence": ["authorization-test", "tenant-isolation-test", "secret-scan"],
      "fix": "Add explicit authorization and tenant scoping, keep secrets outside source, and use the approved guarded operation.",
      "exception": { "allowed": false, "requiresReason": false },
      "knowledgeImpact": ["pallastrade-security Skill", "threat model"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-UI-001",
      "category": "ui-style",
      "title": "UI uses the design system, Tailwind classes, and design tokens",
      "authority": { "file": "storefront/CLAUDE.md", "section": "Code Style" },
      "scope": ["storefront/**/*.{css,js,jsx,ts,tsx}", "platform/packages/{dashboard,dashboard-ui}/**/*.{css,js,jsx,ts,tsx}"],
      "severity": "error",
      "enforcement": { "level": "blocking", "type": "scanner", "verifier": "anti-patterns:AP-001,AP-006" },
      "evidence": ["anti-pattern-scan", "visual-evidence"],
      "fix": "Use an existing design-system component, Tailwind utility, or named design token instead of inline styles and hardcoded colors.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["pallastrade-storefront Skill", "pallastrade-admin Skill"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-INT-001",
      "category": "interaction",
      "title": "Interactive changes define complete states and safe navigation",
      "authority": { "file": "docs/standards/README.md", "section": "样式/视觉规范" },
      "scope": ["storefront/**/*.{jsx,tsx}", "platform/packages/{dashboard,dashboard-ui}/**/*.{jsx,tsx}"],
      "severity": "warning",
      "enforcement": { "level": "review-required", "type": "evidence", "verifier": "interaction-states" },
      "evidence": ["loading-state", "empty-state", "error-state", "disabled-state", "keyboard-and-focus-test"],
      "fix": "Define loading, empty, error, disabled, success, keyboard, focus, responsive, and redirect-loop behavior.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["component documentation", "E2E scenario"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-TEST-001",
      "category": "testing",
      "title": "Every behavior change carries proportional automated and objective evidence",
      "authority": { "file": "AGENTS.md", "section": "§6 Minimum Verification Per Change Type" },
      "scope": ["**/*"],
      "severity": "error",
      "enforcement": { "level": "review-required", "type": "evidence", "verifier": "verification-evidence" },
      "evidence": ["test-command", "exit-code", "commit-state", "runtime-or-visual-evidence"],
      "fix": "Run the required profile and attach the change-type-specific runtime, DOM, screenshot, log, or data evidence.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["test documentation", "acceptance criteria"]
    },
    {
      "schemaVersion": "1.0",
      "type": "Standard",
      "id": "STD-PT-KNOW-001",
      "category": "knowledge",
      "title": "Code, standards, Skills, scenarios, and generated documentation stay synchronized",
      "authority": { "file": "AGENTS.md", "section": "§7 Knowledge Sync Rules" },
      "scope": ["**/*"],
      "severity": "error",
      "enforcement": { "level": "blocking", "type": "workflow", "verifier": "sync-check+doc-impact" },
      "evidence": ["knowledge-impact", "sync-check", "doc-impact"],
      "fix": "Update every required knowledge asset or record a reviewed-no-change conclusion before closing verification.",
      "exception": { "allowed": true, "requiresReason": true },
      "knowledgeImpact": ["AGENTS.md", "Skills", "standards", "scenarios", "API docs"]
    }
  ]
}
