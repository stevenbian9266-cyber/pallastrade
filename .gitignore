# PallasTrade root ignore rules
# Generated caches and temporary artifacts
/.pnpm-store/
/.tmp/
/tmp/
/backups/
/node_modules/

# Harness session state (transient, per-task gates)
/harness/gates/
/.agents/

# Harness scan statistics cache (generated by `harness check` / `harness suggest`)
/.harness-cache/
.DS_Store
Thumbs.db

# Generated harness delivery evidence (regenerate with `harness evidence`)
/artifacts/harness-evidence/

# Editor backups
.vscode/*.backup

# Local-only Claude Code settings (machine-specific, never commit)
.claude/settings.local.json
**/settings.local.json
