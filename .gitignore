# PallasTrade root ignore rules
# Generated caches and temporary artifacts
/.pnpm-store/
/.tmp/
/tmp/
/backups/
/node_modules/

# Harness session state (transient, per-task gates)
/harness/gates/
/.agents/
.DS_Store
Thumbs.db

# Generated harness delivery evidence (regenerate with `harness evidence`)
/artifacts/harness-evidence/

# Editor backups
.vscode/*.backup
