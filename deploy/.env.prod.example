# 生产后端环境（pallastrade-prod）— 复制为 .env.prod 并填写
# 生成: bundle exec rails secret
SECRET_KEY_BASE=

# 商城 publishable key（后台 Settings → API Keys 获取，pk_ 开头）
PALLASTRADE_PUBLISHABLE_KEY=

# SMTP（必配，生产无 mailpit 兜底）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain

# Active Record Encryption（AI Provider 密钥加密，与初始化保持一致）
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# 可选：Sentry / 监控
# SENTRY_DSN=
