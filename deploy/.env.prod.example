# 生产后端环境（pallastrade-prod）— 复制为 .env.prod 并填写
# 生成: bundle exec rails secret
SECRET_KEY_BASE=

# 商城 publishable key（后台 Settings → API Keys 获取，pk_ 开头）
PALLASTRADE_PUBLISHABLE_KEY=

# SMTP（必配，生产无 mailpit 兜底）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain

# Active Record Encryption（AI Provider 密钥加密，与初始化保持一致）
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# 可选：Sentry / 监控
# SENTRY_DSN=

# 阿里云 OSS 图片存储（S3 兼容，virtual-hosted-style）。设置后 active_storage 切到 :aliyun
# 服务器内网 endpoint（同地域免费）：https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=pallastrade-prod
# 绑定 img.pallastrade.cn 自定义域名后设置（图片 URL 直连 OSS/CDN）
# CDN_HOST=img.pallastrade.cn
