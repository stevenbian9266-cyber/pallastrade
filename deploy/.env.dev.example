# 开发后端环境（pallastrade-dev）— 复制为 .env.dev 并填写
SECRET_KEY_BASE=

# AI Tools（pallastrade_ai）—— 系统级总开关，默认关闭。
# 未设为 true 时所有 AI 能力在可用性 Gate 1 即被拦截（后台显示 AI is globally disabled）；
# 供应商 / API Key / 模型 / 能力绑定在后台 /admin/ai 配置，本变量是它们生效的前提。
PALLASTRADE_AI_ENABLED=

# Active Record Encryption —— AI 供应商凭据与 Gateway preferences 等加密列。
# 三项必须同时配置，否则 encrypts 惰性退化为明文。生成：openssl rand -hex 32
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# dev 用独立 publishable key（后台可再生成一个 pk_）
PALLASTRADE_PUBLISHABLE_KEY=

# 开发邮件可留空（走 mailpit 捕获）
# SMTP_HOST=

# 阿里云 OSS 图片存储（S3 兼容，virtual-hosted-style）。设置后 active_storage 切到 :aliyun
# 服务器内网 endpoint（同地域免费）：https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=pallastrade-dev
# 绑定 img.dev.pallastrade.cn 自定义域名后设置（图片 URL 直连 OSS/CDN）
# CDN_HOST=img.dev.pallastrade.cn

# Cloudflare Turnstile 真人验证（注册）——SECRET，绝不入库，仅在服务器 .env.dev 配置
# 配置后注册必须通过人机验证；留空则本地/开发跳过验证
TURNSTILE_SECRET_KEY=
