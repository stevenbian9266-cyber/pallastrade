# storefront 生产环境 — 复制为 .env.storefront.prod 并填写
NEXT_PUBLIC_SITE_URL=https://pallastrade.cn
NEXT_PUBLIC_STORE_NAME=PallasTrade
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_COUNTRY=US

# 运行时 PallasTrade 客户端配置（server components 必需）
PALLASTRADE_API_URL=https://pallastrade.cn
PALLASTRADE_PUBLISHABLE_KEY=pk_your_publishable_key

# 运行时需要的后端密钥（webhook 等）
PALLASTRADE_WEBHOOK_SECRET=

# 可选三方（后续接入）
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# GTM_ID=
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# SENTRY_DSN=

# 品牌 og:image / schema.org logo
STORE_LOGO_URL=

# Cloudflare Turnstile 注册真人验证（site key 公开，非密钥）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
