<% auto_mount ||= false %>

<% if payment_session.present? %>
  <div
    class="<%= !auto_mount ? 'hidden' : '' %>"
    id="dropin-container"
    data-checkout-adyen-checkout-attrubutes="<%= PallasTradeAdyen::CheckoutPresenter.new(payment_session).to_json %>"
    data-checkout-adyen-payment-session-path-value="<%= pallastrade.adyen_payment_session_url(sessionId: payment_session.adyen_id) %>"
    data-checkout-adyen-checkout-path-value="<%= pallastrade.api_v2_storefront_checkout_path %>"
    data-checkout-adyen-auto-mount-value="<%= auto_mount %>"
  ></div>
<% end %>