{
  "name": "@pallastrade/dashboard-plugin-example",
  "private": true,
  "version": "0.0.0",
  "description": "Example PallasTrade dashboard plugin — adds a Brands feature to the admin via defineDashboardPlugin. Reference implementation for the dashboard plugin authoring docs.",
  "type": "module",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "pallastrade": {
    "dashboard": {
      "plugin": true,
      "routes": "./src/routes"
    }
  },
  "peerDependencies": {
    "@pallastrade/admin-sdk": "workspace:^",
    "@pallastrade/dashboard-core": "workspace:^",
    "@pallastrade/dashboard-ui": "workspace:^",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "i18next": "^26.2.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@pallastrade/admin-sdk": "workspace:^",
    "@pallastrade/dashboard-core": "workspace:^",
    "@pallastrade/dashboard-ui": "workspace:^",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.11"
  }
}
