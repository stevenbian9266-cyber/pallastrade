{
  "name": "create-pallastrade-app",
  "version": "1.1.2",
  "description": "Create a new PallasTrade Commerce project with a single command",
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --fix src tests",
    "format": "biome format --write src tests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "pallastrade",
    "commerce",
    "ecommerce",
    "scaffold",
    "create",
    "cli",
    "docker",
    "nextjs",
    "typescript",
    "headless"
  ],
  "author": "Steven Bian <stevenbian9266@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenbian9266-cyber/pallastrade.git",
    "directory": "platform/packages/create-pallastrade-app"
  },
  "homepage": "https://pallastrade.cn",
  "bugs": {
    "url": "https://github.com/stevenbian9266-cyber/pallastrade/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "get-port": "^7.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
