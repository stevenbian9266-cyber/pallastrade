<% if namespace_chain.empty? -%>
module PallasTrade
  module <%= decorator_name %>
    def self.prepended(base)
      # base.before_action :my_filter
    end

    # add custom methods here
  end
end

PallasTrade::<%= controller_name %>.prepend PallasTrade::<%= decorator_name %>
<% else -%>
module PallasTrade::<%= namespace_chain %>
  module <%= decorator_name %>
    def self.prepended(base)
      # base.before_action :my_filter
    end

    # add custom methods here
  end
end

<%= prepend_invocation %>
<% end -%>
