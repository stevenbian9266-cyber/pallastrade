<% content_for :page_title do %>
  <%= page_header_back_button PallasTrade.admin_integrations_path %>
  <%= @integration.name %> <%= PallasTrade.t(:settings) %>
<% end %>

<%= render partial: 'pallastrade/admin/shared/error_messages', locals: { target: @integration } %>

<%= form_for @integration, as: :integration, url: PallasTrade.admin_integration_path(@integration), html: { id: "edit_integration_#{@integration.id}" } do |form| %>
  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-6 lg:col-start-4">
      <%= render "pallastrade/admin/integrations/forms/#{@integration.key}", form: form %>
      <%= render 'pallastrade/admin/shared/edit_resource_links', f: form %>
    </div>
  </div>
<% end %>
