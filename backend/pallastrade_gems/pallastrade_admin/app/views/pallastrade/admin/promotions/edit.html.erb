<%= render 'pallastrade/admin/promotions/header' %>

<%= turbo_frame_tag :promotion_edit_details do %>
  <%= form_for @promotion, url: object_url, method: :put, data: { turbo_frame: '_top' } do |f| %>
    <div class="card mb-6">
      <div class="card-header flex justify-between">
        <h5 class="card-title">
          <%= PallasTrade.t(:details) %>
        </h5>
      </div>
      <div class="card-body">
        <%= render 'pallastrade/admin/shared/error_messages', target: @promotion %>
        <div class="form-group">
          <%= f.label :name %>
          <%= f.text_field :name, class: 'form-input', required: true, autofocus: true %>
          <%= f.error_message_on :name %>
          <span class="form-text mt-2">
            <%= PallasTrade.t('admin.promotions.name_help') %>
          </span>
        </div>

        <% if @promotion.coupon_code? && !@promotion.multi_codes? %>
          <div class="form-group">   
            <%= f.label :code %>
            <%= f.text_field :code, class: 'form-input uppercase', placeholder: PallasTrade.t('admin.promotions.coupon_code_placeholder') %>
          </div>
        <% end %>
      </div>
      <div class="card-footer flex justify-between">
        <%= turbo_save_button_tag PallasTrade.t('actions.update') %>
        <%= link_to PallasTrade.admin_promotion_path(@promotion), class: 'btn btn-light' do %>
          <%= PallasTrade.t('actions.discard') %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<%= turbo_frame_tag :promotion_edit_settings do %>
  <%= form_for @promotion, url: object_url, method: :put do |f| %>
    <div class="card">
      <div class="card-header">
        <h5 class="card-title">
          <%= PallasTrade.t(:settings) %>
        </h5>
      </div>
      <div class="card-body">
        <%= render 'pallastrade/admin/shared/error_messages', target: @promotion %>
        <%= render 'pallastrade/admin/promotions/form/settings', f: f %>
      </div>
      <div class="card-footer flex justify-between">
        <%= turbo_save_button_tag PallasTrade.t('actions.update') %>
        <%= link_to PallasTrade.admin_promotion_path(@promotion), class: 'btn btn-light' do %>
          <%= PallasTrade.t('actions.discard') %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
