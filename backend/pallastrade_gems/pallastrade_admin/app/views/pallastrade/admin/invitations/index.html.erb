<%= render 'pallastrade/admin/shared/section_nav', section: :team %>

<% content_for :page_actions do %>
  <%= render_admin_partials(:invitations_actions_partials) %>
<% end %>

<%= render_admin_partials(:invitations_header_partials) %>

<div class="card-lg">
  <table class="table">
    <thead>
    <tr>
      <th scope="col" class="rounded-xl-top-left"><%= PallasTrade.t(:email) %></th>
      <th scope="col"><%= I18n.t('activerecord.attributes.pallastrade/invitation.inviter') %></th>
      <th scope="col"><%= PallasTrade.t(:role_id) %></th>
      <th scope="col"><%= PallasTrade.t(:status) %></th>
      <th scope="col" class="rounded-xl-top-right"><%= sort_link @search, :created_at, PallasTrade.t(:created_at) %></th>
      <th scope="col"></th>
    </tr>
    </thead>
    <tbody id="invitations">
      <%= render collection: @collection, partial: 'pallastrade/admin/invitations/invitation', as: :invitation %>
    </tbody>
  </table>
</div>