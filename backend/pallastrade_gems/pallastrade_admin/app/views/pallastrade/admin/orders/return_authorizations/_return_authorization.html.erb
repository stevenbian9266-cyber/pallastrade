<% # PALLAS-CUSTOM: 售后归属（PRD-20260824 FR-036）— RA 属于子订单时链接到其自身订单
owner_order = return_authorization.order || @order
edit_link =
  if can?(:edit, return_authorization)
    PallasTrade.edit_admin_order_return_authorization_path(
      owner_order,
      return_authorization,
    )
  else
    PallasTrade.admin_order_return_authorization_path(owner_order, return_authorization)
  end %>

<tr
  id="<%= pallastrade_dom_id(return_authorization) %>"
  data-controller="row-link"
  class="cursor-pointer"
>
  <td data-action="click->row-link#openLink" class="font-bolder">
    <%= link_to return_authorization.number, edit_link %>
  </td>
  <td data-action="click->row-link#openLink">
    <%= link_to owner_order.number, PallasTrade.edit_admin_order_path(owner_order) %>
  </td>
  <td data-action="click->row-link#openLink">
    <small class="badge badge-<%= return_authorization.state %>">
      <%= PallasTrade.t("return_authorization_states.#{return_authorization.state}") %>
    </small>
  </td>
  <td data-action="click->row-link#openLink"><%= return_authorization.display_pre_tax_total.to_html %></td>
  <td data-action="click->row-link#openLink"><%= pallastrade_time(return_authorization.created_at) %></td>
  <td data-action="click->row-link#openLink" class="text-right">
    <%= link_to_edit(
      return_authorization,
      no_text: true,
      data: {
        row_link_target: :link,
      },
      url: edit_link,
    ) %>
  </td>
</tr>
