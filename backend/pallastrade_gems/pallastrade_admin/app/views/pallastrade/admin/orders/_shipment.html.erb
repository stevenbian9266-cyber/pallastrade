<% order ||= shipment.order %>
<%= turbo_frame_tag dom_id(shipment), class: "card" do %>
  <div class="card-header items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="flex items-center"><%= shipment_state(shipment.state) %></span>
      <strong class="shipment-number"><%= shipment.number %></strong>
      <% if shipment.shipped_at.present? %>
        <small class="text-gray-600">
          <%= pallastrade_time_ago(shipment.shipped_at) %>
        </small>
      <% end %>
    </div>

    <span class="flex justify-between items-center gap-2">
      <span class="text-gray-600"><%= PallasTrade.t(:package_from).downcase %></span>
      <span class="font-semibold">
        <% if can?(:edit, shipment.stock_location) %>
          <%= link_to shipment.stock_location.name, PallasTrade.edit_admin_stock_location_path(shipment.stock_location), data: { turbo_frame: '_top' } %>
        <% else %>
          <%= shipment.stock_location.name %>
        <% end %>
      </strong>
    </span>
  </div>
  <div class="card-body mb-0 p-0">
    <div class="shipment-line-items">
      <div class="text-gray-600 text-center border-b py-2 px-4 text-sm shipment-line-items__row">
        <span class="text-left">
          <%= PallasTrade.t(:item_description) %>
        </span>
        <span>
          <%= PallasTrade.t(:price) %>
        </span>
        <span>
          <%= PallasTrade.t(:quantity) %>
        </span>
        <span>
          <%= PallasTrade.t(:total) %>
        </span>
        <span>
        </span>
      </div>
      <%= render collection: shipment.manifest, partial: 'pallastrade/admin/orders/shipment_manifest_item', as: :item, locals: { shipment: shipment } %>
    </div>
    <%= turbo_frame_tag dom_id(shipment, :shipping_method), class: "py-2 px-4 flex justify-between items-center min-h-14" do %>
      <div>
        <% if rate = shipment.selected_shipping_rate %>
          <strong><%= rate.name %></strong>
          <span>
            <%= shipment.display_cost %>
          </span>
        <% else %>
          <%= PallasTrade.t(:no_shipping_method_selected) %>
          <% if shipment.cost.positive? %>
            <span>
              <%= shipment.display_cost %>
            </span>
          <% end %>
        <% end %>
      </div>

      <% if( (can? :update, shipment) and !shipment.shipped? && !order.canceled? && !shipment.canceled?) %>
        <%= link_to_with_icon 'edit', PallasTrade.t(:edit), PallasTrade.edit_admin_order_shipment_path(order, shipment), class: 'btn btn-sm btn-light', no_text: true %>
      <% end %>
    <% end %>

    <% unless shipment.digital? %>
      <%= turbo_frame_tag dom_id(shipment, :tracking), class: "border-t px-4 flex justify-between items-center min-h-14" do %>
        <div class="py-4">
          <strong><%= PallasTrade.t(:tracking) %>: </strong>
          <% if shipment.tracked? %>
            <% if shipment.tracking_url.present? %>
              <span><%= shipment_tracking_link_to(shipment: shipment, html_options: { target: '_blank', rel: 'noopener noreferrer' }) %></span>
            <% elsif shipment.tracking.present? %>
              <span><%= shipment.tracking %></span>
            <% end %>
          <% else %>
            <span class="text-gray-600"><%= PallasTrade.t(:no_tracking_present) %></span>
          <% end %>
        </div>

        <% if can?(:update, shipment) && (!order.canceled? && !shipment.canceled?) %>
          <% if shipment.tracking.present? %>
            <%= link_to_with_icon 'edit', PallasTrade.t(:edit), PallasTrade.edit_admin_order_shipment_path(order, shipment), class: 'btn btn-light btn-sm', no_text: true, title: PallasTrade.t(:edit) %>
          <% else %>
            <%= link_to_with_icon 'plus', PallasTrade.t(:add_one), PallasTrade.edit_admin_order_shipment_path(order, shipment), class: 'btn btn-light btn-sm', no_text: true, title: PallasTrade.t(:add_one) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if can_ship?(shipment) %>
      <div class="card-footer flex justify-end border-t bg-gray-25">
        <% if shipment.tracked? %>
          <%= link_to_with_icon 'send.svg', PallasTrade.t(:ship), PallasTrade.ship_admin_order_shipment_path(order, shipment), class: 'ms-auto btn btn-primary mb-0', data: {turbo_method: :post, turbo_confirm: PallasTrade.t(:are_you_sure), turbo_frame: '_top'} %>
        <% elsif !shipment.digital? %>
          <span class="ship ms-auto btn btn-primary disabled mb-0" data-controller="tooltip" data-tooltip-placement-value="left">
            <%= icon 'send' %>
            <%= PallasTrade.t(:ship) %>
            <%= tooltip(PallasTrade.t('admin.shipment.please_provide_tracking_details')) %>
          </span>
        <% else %>
          <span class="text-gray-600 w-full">
            <%= PallasTrade.t('admin.digital_shipment_fulfillment_note') %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
