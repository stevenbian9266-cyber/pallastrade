<%# PALLAS-CUSTOM: PRD-20260910-promo-batch4a —— 已成交订单展示读快照（历史不可变） %>
<% promotion = order_promotion.promotion %>
<tr>
  <td>
    <%= link_to order_promotion.name, PallasTrade.admin_promotion_path(promotion), class: "font-bold" %>
    <% if order_promotion.frozen? %>
      <span class="badge badge-light ml-1" title="<%= PallasTrade.t('admin.order_promotions.frozen_at', default: 'Frozen at') %> <%= order_promotion.frozen_at&.strftime('%Y-%m-%d %H:%M') %>">
        <%= icon('lock', class: 'mr-0') %>
      </span>
    <% end %>
  </td>
  <td>
    <% if order_promotion.coupon_code? %>
      <span class="badge badge-light"><%= PallasTrade.t(:coupon_code) %></span>
    <% else %>
      <span class="badge badge-info"><%= PallasTrade.t(:automatic_promotion) %></span>
    <% end %>
  </td>
  <td>
    <%= PallasTrade::Money.new(order_promotion.amount, currency: @order.currency).to_html %>
  </td>
  <td class="text-right">
    <% if can?(:destroy, order_promotion) %>
      <%= dropdown do %>
        <%= dropdown_toggle class: 'btn-light btn-sm px-1' do %>
          <%= icon('dots-vertical', class: 'mr-0') %>
        <% end %>
        <%= dropdown_menu do %>
          <%= link_to_with_icon 'trash',
                    PallasTrade.t('actions.destroy'),
                    PallasTrade.admin_order_order_promotion_path(@order, order_promotion),
                    data: { turbo_method: :delete, turbo_confirm: PallasTrade.t(:are_you_sure) },
                    class: "dropdown-item text-red-600 hover:bg-red-100" %>
        <% end %>
      <% end %>
    <% end %>
  </td>
</tr>