<%= turbo_frame_tag dom_id(@order, :customer_information), class: "card mb-6 blur-busy" do  %>
  <div class="card-header">
    <h5 class="card-title">
      <%= PallasTrade.t(:customer) %>
    </h5>
    <% if can?(:update_customer, @order) || can?(:update_addresses, @order) %>
      <%= dropdown id: 'customer-edit-dropdown', class: 'ms-auto', portal: false do %>
        <%= dropdown_toggle class: 'btn-light btn-sm px-1', data: { test_id: 'dropdown-toggle' } do %>
          <%= icon 'dots-vertical', class: 'mr-0' %>
        <% end %>
        <%= dropdown_menu do %>
          <% if can?(:update_customer, @order) && !@order.user.present? %>
            <%= link_to PallasTrade.t('admin.edit_contact_information'), PallasTrade.edit_admin_order_contact_information_path(@order), class: 'dropdown-item', data: { turbo_frame: 'dialog', action: 'dialog#open' } %>
          <% end %>
          <% if can?(:update_addresses, @order) %>
            <%= link_to PallasTrade.t('admin.edit_shipping_address'), PallasTrade.edit_admin_order_shipping_address_path(@order), class: 'dropdown-item', data: { turbo_frame: 'dialog', action: 'dialog#open' } if @order.shipping_address.present? %>
            <%= link_to PallasTrade.t('admin.edit_billing_address'), PallasTrade.edit_admin_order_billing_address_path(@order), class: 'dropdown-item', data: { turbo_frame: 'dialog', action: 'dialog#open' } if @order.billing_address.present? %>
          <% end %>
          <% if can?(:update_customer, @order) %>
            <% if @order.user.present? %>
              <%= link_to PallasTrade.t('admin.orders.remove_user_from_this_order'), PallasTrade.admin_order_user_path(@order), class: 'dropdown-item text-red-600 hover:bg-red-100', data: { turbo_method: :delete, turbo_confirm: PallasTrade.t(:are_you_sure), turbo_frame: :_top } %>
            <% else %>
              <%= link_to PallasTrade.t('admin.orders.add_user_to_this_order'), PallasTrade.new_admin_order_user_path(@order), class: 'dropdown-item' %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="card-body">
    <% unless defined?(current_vendor) && current_vendor %>
      <% unless @order.user.present? %>
        <h6><%= PallasTrade.t(:contact_information) %></h6>
      <% end %>
      <div class='card-text flex flex-col'>
        <% if @order.user.present? %>
          <%= render 'pallastrade/admin/shared/user', user: @order.user %>
          <%= render 'pallastrade/admin/orders/user_overview', user: @order.user %>
        <% elsif @order.email.present? %>
          <div class="flex items-center w-full gap-2 py-2">
            <%= mail_to @order.email, @order.email, class: 'text-blue' %>
            <%= clipboard_component(@order.email) %>
          </div>
        <% else %>
          <span class="text-gray-600">
            <%= PallasTrade.t(:no_email_provided) %>
          </span>
        <% end %>
        <% if !@order.user.present? && can?(:update_customer, @order) %>
          <%= link_to_with_icon 'plus', PallasTrade.t('admin.orders.add_user_to_this_order'), PallasTrade.new_admin_order_user_path(@order), class: "btn btn-secondary mt-4" %>
        <% end %>
      </div>
    <% end %>
    <h6 class="font-bold mt-6 mb-2"><%= PallasTrade.t(:shipping_address) %></h6>
    <%= turbo_frame_tag :order_ship_address do %>
      <% if @order.ship_address.present? %>
        <%= render 'pallastrade/admin/shared/address', address: @order.ship_address %>
      <% elsif can?(:update_addresses, @order) %>
        <%= link_to_with_icon 'plus', PallasTrade.t(:new_shipping_address), PallasTrade.new_admin_order_shipping_address_path(@order), class: "btn btn-secondary w-full", data: { turbo_frame: 'dialog', action: 'dialog#open' } %>
      <% else %>
        <span class="text-gray-600"><%= PallasTrade.t(:no_shipping_address_available) %></span>
      <% end %>
    <% end %>
    <h6 class="font-bold mt-6 mb-2"><%= PallasTrade.t(:billing_address) %></h6>
    <%= turbo_frame_tag :order_bill_address do %>
      <% if @order.shipping_eq_billing_address? && @order.bill_address.present? %>
        <span class="text-gray-600"><%= PallasTrade.t(:same_as_shipping_address) %></span>
      <% elsif @order.bill_address.present? %>
        <%= render 'pallastrade/admin/shared/address', address: @order.bill_address %>
      <% elsif can?(:update_addresses, @order) %>
        <%= link_to_with_icon 'plus', PallasTrade.t(:new_billing_address), PallasTrade.new_admin_order_billing_address_path(@order), class: "btn btn-secondary w-full", data: { turbo_frame: 'dialog', action: 'dialog#open' } %>
      <% else %>
        <span class="text-gray-600"><%= PallasTrade.t(:no_billing_address_available) %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
