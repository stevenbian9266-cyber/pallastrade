<%= content_for(:title, PallasTrade.t('admin.emails.send_log')) %>
<%= content_for(:page_actions) do %>
  <%= link_to PallasTrade.t('actions.back'), PallasTrade.admin_email_logs_path, class: 'btn btn-outline' %>
<% end %>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= @object.subject.presence || @object.action %></h5>
    <span class="badge <%= @object.failed? ? 'badge-danger' : 'badge-success' %>"><%= @object.status %></span>
  </div>
  <div class="card-body">
    <dl class="grid grid-cols-2 gap-4">
      <div>
        <dt class="text-gray-500 text-sm"><%= PallasTrade.t('admin.emails.mailer') %></dt>
        <dd><code><%= @object.mailer %>#<%= @object.action %></code></dd>
      </div>
      <div>
        <dt class="text-gray-500 text-sm"><%= PallasTrade.t('admin.emails.to') %></dt>
        <dd><%= @object.to %></dd>
      </div>
      <div>
        <dt class="text-gray-500 text-sm"><%= PallasTrade.t('admin.emails.from') %></dt>
        <dd><%= @object.from %></dd>
      </div>
      <div>
        <dt class="text-gray-500 text-sm"><%= PallasTrade.t('admin.emails.sent_at') %></dt>
        <dd><%= l(@object.sent_at, format: :long) if @object.sent_at %></dd>
      </div>
      <% if @object.error.present? %>
        <div class="col-span-2">
          <dt class="text-gray-500 text-sm"><%= PallasTrade.t('admin.emails.error') %></dt>
          <dd class="text-danger"><%= @object.error %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
