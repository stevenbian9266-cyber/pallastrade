<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">
      <%= PallasTrade.t(:general_settings) %>
    </h5>
  </div>

  <div class="card-body">
    <%= f.pallastrade_text_field :name, required: true %>

    <%= f.pallastrade_select :country_ids, country_select_options(@countries), { include_blank: false, label: PallasTrade.t(:countries), autocomplete: true, multiple: true } %>

    <%= f.pallastrade_select :currency, currency_options(f.object.currency), { label: PallasTrade.t(:currency), required: true, autocomplete: true }, { data: { display_names_type: 'currency' } } %>

    <%= f.pallastrade_select :default_locale,
          options_from_collection_for_select(translation_locales_options, :last, :first, f.object.default_locale || I18n.locale),
          { required: true, autocomplete: true },
          { data: { display_names_type: 'language' } } %>

    <%= f.pallastrade_select :supported_locales,
          options_from_collection_for_select(translation_locales_options, :last, :first, f.object.supported_locales&.split(',')),
          { multiple: true, autocomplete: true, hint: PallasTrade.t('admin.markets.supported_locales_hint') },
          { data: { display_names_type: 'language' } } %>

    <hr class="my-6">

    <%= f.pallastrade_check_box :tax_inclusive %>
    <%= f.pallastrade_check_box :default %>
  </div>
</div>
