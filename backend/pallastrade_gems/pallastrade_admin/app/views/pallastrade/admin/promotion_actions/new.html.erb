<%= turbo_frame_tag :dialog do %>
  <%= form_with model: @promotion_action, url: PallasTrade.admin_promotion_actions_path(@promotion), method: :post, scope: :promotion_action do |f| %>
    <% if @promotion_action.type.nil? %>
      <%= dialog_header(PallasTrade.t(:add_action_of_type)) %>
    <% else %>
      <%= dialog_header(@promotion_action.human_name) %>
    <% end %>
    <div class="dialog-body">
      <%= render partial: 'pallastrade/admin/shared/error_messages', locals: { target: @promotion_action } %>
      <% if @promotion_action.type.nil? %>
        <% promotion_action_entries(@promotion).each do |entry| %>
            <%= link_to PallasTrade.new_admin_promotion_action_path(@promotion, promotion_action: { type: entry.type }), class: 'flex align-items-top w-full py-2 px-4 hover:bg-gray-100 rounded-xl mb-2 no-underline', data: { turbo_prefetch: false } do %>
              <%= radio_button_tag :type, entry.type, class: 'hidden', checked: @promotion_action.type == entry.type %>
              <div>
                <h6><%= entry.label %></h6>
                <p class="text-gray-600 mb-0"><%= entry.description %></p>
              </div>
            <% end %>
        <% end %>
      <% else %>
        <p class="text-gray-600">
          <%= @promotion_action.human_description %>
        </p>
        <%= f.hidden_field :type, value: @promotion_action.type %>
        <%= render promotion_action_form_partial(@promotion_action), f: f %>
      <% end %>
    </div>
    <% if @promotion_action.type.present? %>
      <div class="dialog-footer">
        <%= dialog_discard_button %>
        <%= turbo_save_button_tag PallasTrade.t('actions.create'), data: { turbo_frame: '_top' } %>
      </div>
    <% end %>
  <% end %>
<% end %>