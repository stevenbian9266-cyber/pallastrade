<% content_for(:title, @dispute.prefixed_id) %>
<% content_for :page_title do %>
  <%= @dispute.prefixed_id %>
<% end %>
<%# DSP-P7-7 (PRD-20260913-payments-dsp-p7-7-admin-disputes-console)：§66 展现面 + §67 安全动作 %>
<%# DSP-P7-8 (PRD-20260913-payments-dsp-p7-8)：危险操作区（提交证据 / 接受争议）—— %>
<%#   仅 :update 权限可见；前端 turbo_confirm + 后端显式 confirm 参数双重确认；provider 不支持则整卡降级。 %>
<% content_for :page_actions do %>
  <% if can?(:read, @dispute) %>
    <%= button_to PallasTrade.t('admin.orders.disputes_refresh'),
                  PallasTrade.refresh_admin_dispute_path(@dispute),
                  method: :post,
                  class: 'btn btn-outline' %>
    <%= button_to PallasTrade.t('admin.orders.disputes_dry_run'),
                  PallasTrade.dry_run_admin_dispute_path(@dispute),
                  method: :post,
                  data: { turbo_confirm: PallasTrade.t('admin.orders.disputes_dry_run_confirm') },
                  class: 'btn btn-outline' %>
    <%= button_to PallasTrade.t('admin.orders.disputes_snapshot'),
                  PallasTrade.snapshot_admin_dispute_path(@dispute),
                  method: :post,
                  class: 'btn btn-outline' %>
  <% end %>
  <% if can?(:update, @dispute) %>
    <%= button_to PallasTrade.t('admin.orders.disputes_recover'),
                  PallasTrade.recover_admin_dispute_path(@dispute),
                  method: :post,
                  data: { turbo_confirm: PallasTrade.t('admin.orders.disputes_recover_confirm') },
                  class: 'btn btn-warning' %>
    <%= button_to PallasTrade.t('admin.orders.disputes_mark_review'),
                  PallasTrade.mark_review_admin_dispute_path(@dispute),
                  method: :post,
                  data: { turbo_confirm: PallasTrade.t('admin.orders.disputes_mark_review_confirm') },
                  class: 'btn btn-warning' %>
  <% end %>
  <%= link_to PallasTrade.t('actions.back'), PallasTrade.admin_disputes_path, class: 'btn btn-outline' %>
<% end %>

<% dispute = @dispute || @object %>
<% payment = dispute.payment %>
<% order = dispute.order %>
<% transaction = dispute.commerce_transaction %>

<%# ── 1. 争议概览（Dispute ID / Provider / Amount-Currency / Reason / State / Flags / Deadline） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.orders.disputes_ops') %></h5>
  </div>
  <div class="card-body">
    <dl class="grid grid-cols-2 gap-4">
      <div>
        <dt class="text-sm text-gray-500">Dispute ID</dt>
        <dd><%= dispute.prefixed_id %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Provider</dt>
        <dd><%= dispute.provider %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Amount / Currency</dt>
        <dd><%= format('%.2f', dispute.amount.to_f) %> <%= dispute.currency.to_s.upcase %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">State</dt>
        <dd><%= dispute_state_badge(dispute) %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Kind</dt>
        <dd><%= dispute.kind.presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_flags') %></dt>
        <dd><%= dispute_attention_badge(dispute) %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Reason</dt>
        <dd><%= dispute.reason.presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Network reason code</dt>
        <dd><%= dispute.network_reason_code.presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_deadline') %></dt>
        <dd><%= dispute.evidence_due_at&.strftime('%Y-%m-%d %H:%M') || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Evidence submitted at</dt>
        <dd><%= dispute.evidence_submitted_at&.strftime('%Y-%m-%d %H:%M') || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Funds withdrawn / reinstated</dt>
        <dd>
          <%= dispute.funds_withdrawn_at&.strftime('%Y-%m-%d %H:%M') || '—' %>
          /
          <%= dispute.funds_reinstated_at&.strftime('%Y-%m-%d %H:%M') || '—' %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Resolved at</dt>
        <dd><%= dispute.resolved_at&.strftime('%Y-%m-%d %H:%M') || '—' %></dd>
      </div>
    </dl>
  </div>
</div>

<%# ── 2. 锚点：Payment / CommerceTransaction / Order + Provider references ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">Anchors &amp; provider references</h5>
  </div>
  <div class="card-body">
    <dl class="grid grid-cols-2 gap-4">
      <div>
        <dt class="text-sm text-gray-500">Payment</dt>
        <dd>
          <% if payment %>
            <%= link_to payment.prefixed_id, PallasTrade.admin_payment_path(payment) %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Commerce transaction</dt>
        <dd>
          <% if transaction %>
            <%= link_to transaction.prefixed_id, PallasTrade.admin_transaction_path(transaction) %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Order</dt>
        <dd><%= order ? order.number : '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Provider dispute reference</dt>
        <dd><%= dispute.provider_dispute_reference %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Provider charge reference</dt>
        <dd><%= dispute.provider_charge_reference.presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Provider payment reference</dt>
        <dd><%= dispute.provider_payment_reference.presence || '—' %></dd>
      </div>
    </dl>
  </div>
</div>

<%# ── 3. 判定与收敛状态（裁决 / 收敛审计 / 最近 provider 事件） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">Provider truth &amp; recovery</h5>
  </div>
  <div class="card-body">
    <dl class="grid grid-cols-2 gap-4">
      <div>
        <dt class="text-sm text-gray-500">Resolution (provider ↔ local)</dt>
        <dd><%= dispute_resolution_badge(@fact&.resolution) %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Fact</dt>
        <dd>
          <%= @fact&.fact_type || '—' %>
          (<%= @fact&.status || '—' %>, source: <%= @fact&.source || '—' %>)
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Last observed provider status</dt>
        <dd><%= @fact&.provider_status.presence || dispute.private_metadata&.dig('provider_status').presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Recovery</dt>
        <dd><%= dispute_recovery_hint(dispute, @recovery) %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-500">Last provider event</dt>
        <dd>
          <% if @last_provider_event %>
            <%= @last_provider_event.action %> ·
            <%= @last_provider_event.status %> ·
            <%= @last_provider_event.created_at.strftime('%Y-%m-%d %H:%M') %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
    </dl>
  </div>
</div>

<%# ── 4. Financial movements / Journal（只读账本派行） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">Financial movements (journal)</h5>
  </div>
  <div class="card-body">
    <% if @journal_entries.any? %>
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Entry</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Effective at</th>
            <th>State</th>
          </tr>
        </thead>
        <tbody>
          <% @journal_entries.each do |entry| %>
            <tr>
              <td><%= entry.prefixed_id %></td>
              <td><%= entry.entry_type %></td>
              <td><%= format('%.2f', entry.amount.to_f) %> <%= entry.currency.to_s.upcase %></td>
              <td><%= entry.effective_at&.strftime('%Y-%m-%d %H:%M') %></td>
              <td><%= entry.state %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 mb-0">No journal entries yet.</p>
    <% end %>
  </div>
</div>

<%# ── 5. Reconciliation（在线只读；异常降级） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">Reconciliation</h5>
  </div>
  <div class="card-body">
    <% if @reconciliation %>
      <dl class="grid grid-cols-2 gap-4">
        <div>
          <dt class="text-sm text-gray-500">Classification</dt>
          <dd><%= @reconciliation[:classification] %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Capability</dt>
          <dd><%= @reconciliation[:capability] %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Reasons</dt>
          <dd><%= Array(@reconciliation[:reasons]).join(', ').presence || '—' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Expected entries</dt>
          <dd><%= Array(@reconciliation[:expected_entries]).map { |e| e[:entry_type] }.join(', ').presence || '—' %></dd>
        </div>
      </dl>
    <% else %>
      <p class="text-gray-500 mb-0">Reconciliation unavailable (degraded — the page stays read-only).</p>
    <% end %>
  </div>
</div>

<%# ── 6. Evidence snapshot（在线只读投影；不落库、不提交） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">Evidence snapshot</h5>
  </div>
  <div class="card-body">
    <% if @evidence %>
      <p class="text-gray-500">
        Submission ready: <strong><%= @evidence.submission_ready? %></strong>
        · missing: <strong><%= @evidence.missing_evidence.size %></strong>
        (submitting evidence is a protected workflow outside this console)
      </p>
      <% if @evidence_sections.any? %>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Section</th>
              <th>Availability</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody>
            <% @evidence_sections.each do |section| %>
              <tr>
                <td><%= section[:name] %></td>
                <td><%= section[:availability] || '—' %></td>
                <td><%= section[:reason] || '—' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% if @evidence.missing_evidence.any? %>
        <p class="mb-0"><strong>Missing:</strong> <%= @evidence.missing_evidence.join(', ') %></p>
      <% end %>
    <% else %>
      <p class="text-gray-500 mb-0">Evidence snapshot unavailable (degraded — nothing is stored or submitted).</p>
    <% end %>
  </div>
</div>

<%# ── 7. Refund overlap（同一 payment 的退款队列，只读） ── %>
<div class="card">
  <div class="card-header">
    <h5 class="card-title">Refund overlap</h5>
  </div>
  <div class="card-body">
    <% if @refunds.any? %>
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Refund</th>
            <th>State</th>
            <th>Amount</th>
            <th>Created at</th>
          </tr>
        </thead>
        <tbody>
          <% @refunds.each do |refund| %>
            <tr>
              <td><%= refund.prefixed_id %></td>
              <td><%= refund_state_badge(refund) %></td>
              <td><%= format('%.2f', refund.amount.to_f) %> <%= refund.currency.to_s.upcase %></td>
              <td><%= refund.created_at&.strftime('%Y-%m-%d %H:%M') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 mb-0">No refunds on the anchored payment.</p>
    <% end %>
  </div>
</div>

<%# ── 期限分档提醒历史（D14 切片2 / §71.2，台账只读） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.orders.disputes_deadline_history_title') %></h5>
  </div>
  <div class="card-body">
    <% badge = @deadline_badge %>
    <p class="text-sm text-gray-500 mb-4">
      <%= PallasTrade.t('admin.orders.disputes_deadline_history_help',
                        due: badge[:due_at] ? l(badge[:due_at], format: :long) : '—',
                        tier: badge[:tier] ? PallasTrade.t("admin.orders.disputes_deadline_tier_#{badge[:tier]}") : '—') %>
    </p>

    <% if @deadline_alerts.present? %>
      <table class="table">
        <thead>
          <tr>
            <th><%= PallasTrade.t('admin.orders.disputes_deadline_history_tier') %></th>
            <th><%= PallasTrade.t('admin.orders.disputes_deadline_history_at') %></th>
            <th><%= PallasTrade.t('admin.orders.disputes_deadline_history_hours') %></th>
            <th><%= PallasTrade.t('admin.orders.disputes_deadline_history_kind') %></th>
          </tr>
        </thead>
        <tbody>
          <% @deadline_alerts.each do |alert| %>
            <tr>
              <td>
                <span class="badge <%= dispute_deadline_class(alert.tier) %>">
                  <%= PallasTrade.t("admin.orders.disputes_deadline_tier_#{alert.tier}") %>
                </span>
              </td>
              <td><%= l(alert.alerted_at, format: :short) %></td>
              <td><%= alert.hours_remaining %></td>
              <td>
                <%= alert.backfilled? ? PallasTrade.t('admin.orders.disputes_deadline_history_backfilled') : PallasTrade.t('admin.orders.disputes_deadline_history_live') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 mb-0"><%= PallasTrade.t('admin.orders.disputes_deadline_history_empty') %></p>
    <% end %>
  </div>
</div>

<%# ── 7.5 提交历史 / 版本 / 回执（DSP-P7-10 B1，只读） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.orders.disputes_timeline') %></h5>
  </div>
  <div class="card-body">
    <p class="text-sm text-gray-500 mb-3"><%= PallasTrade.t('admin.orders.disputes_timeline_help') %></p>
    <% receipt_state = (@submission_timeline && @submission_timeline[:receipt] ? @submission_timeline[:receipt][:state] : nil) %>
    <p class="mb-3">
      <span class="badge">
        <%= PallasTrade.t('admin.orders.disputes_receipt_state',
                          state: receipt_state ? PallasTrade.t("admin.orders.disputes_receipt_#{receipt_state}") : PallasTrade.t('admin.orders.disputes_receipt_none')) %>
      </span>
      <span class="text-gray-500 text-xs"><%= PallasTrade.t('admin.orders.disputes_receipt_help') %></span>
    </p>
    <% timeline_entries = @submission_timeline&.[](:entries) || [] %>
    <% if timeline_entries.any? %>
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Ver</th>
            <th>Action</th>
            <th>Provider status</th>
            <th>Reference</th>
            <th>Evidence keys</th>
            <th>Diff vs previous</th>
            <th>When</th>
            <th>Actor</th>
          </tr>
        </thead>
        <tbody>
          <% timeline_entries.each do |entry| %>
            <tr>
              <td><span class="badge"><%= PallasTrade.t('admin.orders.disputes_timeline_version', version: entry[:version]) %></span></td>
              <td class="text-sm"><%= entry[:kind] %><% if entry[:late] %> <span class="text-red-700">(late)</span><% end %></td>
              <td class="text-sm"><%= entry[:provider_status].presence || '—' %></td>
              <td class="text-xs"><%= entry[:provider_reference].presence || '—' %></td>
              <td class="text-xs"><%= entry[:evidence_keys].join(', ').presence || '—' %></td>
              <td class="text-xs">
                <% if entry[:diff][:first] %>
                  first submission
                <% else %>
                  <%= PallasTrade.t('admin.orders.disputes_timeline_diff',
                                    added: entry[:diff][:added].join(', ').presence || '—',
                                    removed: entry[:diff][:removed].join(', ').presence || '—') %>
                <% end %>
              </td>
              <td class="text-xs"><%= entry[:at]&.strftime('%Y-%m-%d %H:%M') %></td>
              <td class="text-xs"><%= entry[:actor][:label].presence || '—' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 mb-0"><%= PallasTrade.t('admin.orders.disputes_timeline_empty') %></p>
    <% end %>
  </div>
</div>

<%# ── 7.6 证据素材库 + provider 建议（DSP-P7-10 B1；只读引用，绝不自动提交/生成） ── %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.orders.disputes_evidence_library') %></h5>
  </div>
  <div class="card-body">
    <p class="text-sm text-gray-500 mb-3"><%= PallasTrade.t('admin.orders.disputes_evidence_library_help') %></p>
    <% if @evidence_assets.any? %>
      <ul class="mb-4">
        <% @evidence_assets.each do |asset| %>
          <li class="text-sm">
            <strong><%= asset.name %></strong>
            <span class="text-gray-500">
              (<%= asset.kind %><%= asset.evidence_key.present? ? " · #{asset.evidence_key}" : '' %><%= asset.reason_code.present? ? " · #{asset.reason_code}" : '' %>)
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500"><%= PallasTrade.t('admin.orders.disputes_evidence_library_empty') %></p>
    <% end %>

    <h6 class="text-sm font-semibold mb-2"><%= PallasTrade.t('admin.orders.disputes_evidence_suggestions') %></h6>
    <p class="text-sm text-gray-500 mb-2"><%= PallasTrade.t('admin.orders.disputes_evidence_suggestions_help') %></p>
    <% if @evidence_suggestions && @evidence_suggestions[:supported] %>
      <% if @evidence_suggestions[:suggestions].any? %>
        <ul class="mb-0">
          <% @evidence_suggestions[:suggestions].each do |suggestion| %>
            <li class="text-sm">
              <strong><%= suggestion[:key] %></strong>
              <span class="text-gray-500">(<%= suggestion[:type] %><%= suggestion[:required] ? ', required' : '' %>)</span>
              — <%= suggestion[:assets].map { |asset| asset[:name] }.join(', ') %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500 mb-0">—</p>
      <% end %>
    <% else %>
      <p class="text-gray-500 mb-0"><%= PallasTrade.t('admin.orders.disputes_evidence_suggestions_unsupported') %></p>
    <% end %>
  </div>
</div>

<%# ── 7.7 退货/补货（RMA）人工入口（DSP-P7-10 B3 / FR-008）─────────────────────── %>
<%# 只做**跳转**：库存与订单仍走原有显式流程（争议侧零库存写、零自动补货） %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.orders.disputes_return_entry') %></h5>
  </div>
  <div class="card-body">
    <p class="text-sm text-gray-500 mb-3"><%= PallasTrade.t('admin.orders.disputes_return_entry_help') %></p>
    <% if dispute.order.present? %>
      <%= link_to PallasTrade.t('admin.orders.disputes_return_entry_action'),
                  PallasTrade.parent_order_returns_admin_order_path(dispute.order),
                  class: 'btn btn-secondary' %>
    <% else %>
      <p class="text-gray-500 mb-0"><%= PallasTrade.t('admin.orders.disputes_return_entry_missing_order') %></p>
    <% end %>
  </div>
</div>

<%# ── 8. 【危险操作】提交证据 / 接受争议（DSP-P7-8）────────────────────────────── %>
<%# 三件套：permission（can?(:update)）+ confirmation（turbo_confirm + confirm 参数）+ audit（服务内） %>
<div class="card mb-6 border-red-300">
  <div class="card-header">
    <h5 class="card-title text-red-700"><%= PallasTrade.t('admin.orders.disputes_danger_zone') %></h5>
  </div>
  <div class="card-body">
    <p class="text-sm text-gray-500 mb-4">
      <%= PallasTrade.t('admin.orders.disputes_danger_zone_help') %>
    </p>

    <% if @evidence_catalog.nil? %>
      <div class="alert alert-warning mb-0">
        <%= PallasTrade.t('admin.orders.disputes_danger_unsupported') %>
      </div>
    <% elsif !can?(:update, dispute) %>
      <div class="alert alert-info mb-0">
        <%= PallasTrade.t('admin.orders.disputes_danger_no_permission') %>
      </div>
    <% else %>
      <% if @late_submission %>
        <div class="alert alert-warning">
          <%= PallasTrade.t('admin.orders.disputes_danger_late_warning',
                            due_at: dispute.evidence_due_at&.strftime('%Y-%m-%d %H:%M')) %>
        </div>
      <% end %>

      <% if @evidence_review_required %>
        <div class="alert alert-warning">
          <%= PallasTrade.t('admin.orders.disputes_review_required') %>
        </div>
      <% end %>

      <% if @evidence_approvals.any? %>
        <div class="mb-4">
          <h6 class="text-sm font-semibold mb-2"><%= PallasTrade.t('admin.orders.disputes_approvals') %></h6>
          <ul class="mb-0">
            <% @evidence_approvals.each do |approval| %>
              <li class="text-sm">
                <span class="badge"><%= approval.decision %></span>
                <span class="text-gray-500"><%= approval.actor_label.presence || '—' %></span>
                <span class="text-gray-500 text-xs">· <%= approval.created_at&.strftime('%Y-%m-%d %H:%M') %></span>
                <% if approval.requested_by.present? %>
                  <span class="text-gray-500 text-xs">· requested by <%= approval.requested_by %></span>
                <% end %>
                <% if approval.note.present? %>
                  <span class="text-gray-500 text-xs">· <%= approval.note %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% elsif @evidence_review_required %>
        <p class="text-sm text-gray-500 mb-4"><%= PallasTrade.t('admin.orders.disputes_approvals_empty') %></p>
      <% end %>

      <%# 1) 提交证据：文本 + 文件（文件走 Stripe File 上传；留存挂回执） %>
      <%= form_with url: PallasTrade.submit_evidence_admin_dispute_path(dispute),
                    method: :post, multipart: true, local: true do |f| %>
        <h6 class="text-sm font-semibold mb-2"><%= PallasTrade.t('admin.orders.disputes_submit_evidence') %></h6>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <% @evidence_catalog.text_entries.each do |entry| %>
            <div>
              <label class="text-sm text-gray-500" for="evidence_<%= entry.key %>">
                <%= entry.key.humanize %>
              </label>
              <%= text_field_tag "evidence[#{entry.key}]", nil,
                                 id: "evidence_#{entry.key}",
                                 maxlength: entry.max_length,
                                 class: 'form-input w-full' %>
            </div>
          <% end %>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-3">
          <% @evidence_catalog.file_entries.each do |entry| %>
            <div>
              <label class="text-sm text-gray-500" for="evidence_<%= entry.key %>">
                <%= entry.key.humanize %>
              </label>
              <%= file_field_tag "evidence[#{entry.key}]", id: "evidence_#{entry.key}", class: 'form-input w-full' %>
            </div>
          <% end %>
        </div>

        <% if @late_submission %>
          <div class="mb-3">
            <%= hidden_field_tag :late_confirmed, '0' %>
            <%= check_box_tag :late_confirmed, '1', false, id: 'late_confirmed' %>
            <label for="late_confirmed" class="text-sm text-red-700">
              <%= PallasTrade.t('admin.orders.disputes_danger_late_confirm') %>
            </label>
          </div>
        <% end %>

        <%= f.submit PallasTrade.t('admin.orders.disputes_draft_precheck'),
                     formaction: PallasTrade.precheck_admin_dispute_path(dispute),
                     formmethod: :post,
                     class: 'btn btn-secondary mr-2' %>
        <%= f.submit PallasTrade.t('admin.orders.disputes_approve_draft'),
                     formaction: PallasTrade.approve_draft_admin_dispute_path(dispute),
                     formmethod: :post,
                     class: 'btn btn-secondary mr-2' %>
        <%= f.submit PallasTrade.t('admin.orders.disputes_submit_evidence'),
                     data: { turbo_confirm: PallasTrade.t('admin.orders.disputes_submit_evidence_confirm') },
                     class: 'btn btn-warning' %>
      <% end %>

      <hr class="my-5">

      <%# 2) 接受争议（不可逆）：必须填写理由 + 显式确认 %>
      <%= form_with url: PallasTrade.accept_dispute_admin_dispute_path(dispute),
                    method: :post, local: true do |f| %>
        <h6 class="text-sm font-semibold mb-2 text-red-700"><%= PallasTrade.t('admin.orders.disputes_accept') %></h6>
        <p class="text-sm text-gray-500 mb-3"><%= PallasTrade.t('admin.orders.disputes_accept_help') %></p>
        <div class="mb-3">
          <label class="text-sm text-gray-500" for="accept_reason">
            <%= PallasTrade.t('admin.orders.disputes_accept_reason') %>
          </label>
          <%= text_area_tag :reason, nil, id: 'accept_reason', rows: 2, class: 'form-input w-full' %>
        </div>
        <%= hidden_field_tag :confirm, '1' %>
        <%= f.submit PallasTrade.t('admin.orders.disputes_accept'),
                     data: { turbo_confirm: PallasTrade.t('admin.orders.disputes_accept_confirm') },
                     class: 'btn btn-danger' %>
      <% end %>
    <% end %>

    <% if @evidence_submissions.any? %>
      <hr class="my-5">
      <h6 class="text-sm font-semibold mb-2"><%= PallasTrade.t('admin.orders.disputes_submissions') %></h6>
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Kind</th>
            <th>Provider status</th>
            <th>Actor</th>
            <th>Late</th>
            <th>At</th>
          </tr>
        </thead>
        <tbody>
          <% @evidence_submissions.each do |submission| %>
            <tr>
              <td><%= submission.accepted? ? PallasTrade.t('admin.orders.disputes_accept') : PallasTrade.t('admin.orders.disputes_submit_evidence') %></td>
              <td><%= submission.provider_status.presence || '—' %></td>
              <td><%= submission.actor_label.presence || submission.actor_type.presence || '—' %></td>
              <td><%= submission.late ? 'yes' : 'no' %></td>
              <td><%= submission.created_at&.strftime('%Y-%m-%d %H:%M') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<%# DSP-P7-9 (PRD-20260913-payments-dsp-p7-9)：**只读**视图 —— provider 能力矩阵 + 支付级多争议聚合 %>
<%#   铁律：零写、零资金动作、逐项 rescue 降级（页面绑不 500） %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.orders.disputes_capability_title') %></h5>
  </div>
  <div class="card-body">
    <p class="text-sm text-gray-500 mb-4"><%= PallasTrade.t('admin.orders.disputes_capability_help') %></p>

    <% if @provider_capabilities.nil? %>
      <p class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_no_payment') %></p>
    <% else %>
      <% capabilities = @provider_capabilities[:capabilities] || {} %>
      <table class="table table-sm">
        <tbody>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_provider') %></td>
            <td><%= @provider_capabilities[:provider].to_s.upcase %></td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_contract') %></td>
            <td>
              <% if capabilities[:supported] == true %>
                <span class="badge badge-success"><%= PallasTrade.t('admin.orders.disputes_capability_supported') %></span>
              <% else %>
                <span class="badge badge-warning"><%= capabilities[:reason].presence || 'unsupported_provider' %></span>
              <% end %>
            </td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_evidence') %></td>
            <td><%= capabilities[:evidence_submission] ? 'yes' : 'no' %>
              <% text_keys = Array(capabilities[:evidence_text_keys]); file_keys = Array(capabilities[:evidence_file_keys]) %>
              <% if text_keys.any? || file_keys.any? %>
                <span class="text-sm text-gray-500">(<%= text_keys.size %> / <%= file_keys.size %>)</span>
              <% end %>
            </td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_accept') %></td>
            <td><%= capabilities[:accept_dispute] ? 'yes' : 'no' %></td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_fee') %></td>
            <td><%= capabilities[:fee_capture] ? 'yes' : 'no' %></td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_capability_scope') %></td>
            <td><%= @dispute.partial? ? PallasTrade.t('admin.orders.disputes_partial') : PallasTrade.t('admin.orders.disputes_full') %></td>
          </tr>
        </tbody>
      </table>
      <% if capabilities[:supported] != true %>
        <p class="text-sm text-warning"><%= PallasTrade.t('admin.orders.disputes_capability_unsupported') %></p>
      <% end %>
    <% end %>

    <% if @payment_summary %>
      <hr class="my-4">
      <h6 class="text-sm font-semibold mb-2"><%= PallasTrade.t('admin.orders.disputes_payment_summary') %></h6>
      <table class="table table-sm">
        <tbody>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_payment_count') %></td>
            <td><%= @payment_summary[:dispute_count] %> (<%= @payment_summary[:active_count] %>)</td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_payment_disputed') %></td>
            <td>
              <% if @payment_summary[:disputed_total] %>
                <%= format('%.2f', @payment_summary[:disputed_total].to_f) %> <%= @payment_summary[:currency].to_s.upcase %>
              <% else %>
                <%= PallasTrade.t('admin.orders.disputes_payment_mixed') %>
              <% end %>
            </td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_payment_amount') %></td>
            <td>
              <% if @payment_summary[:payment_amount] %>
                <%= format('%.2f', @payment_summary[:payment_amount].to_f) %>
              <% else %>
                &mdash;
              <% end %>
            </td>
          </tr>
          <tr>
            <td class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.disputes_payment_remaining') %></td>
            <td>
              <% if @payment_summary[:remaining_amount] %>
                <%= format('%.2f', @payment_summary[:remaining_amount].to_f) %>
              <% else %>
                &mdash;
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
      <% if @payment_summary[:exceeds_payment] %>
        <p class="text-sm text-warning"><%= PallasTrade.t('admin.orders.disputes_payment_exceeds') %></p>
      <% end %>
    <% end %>
  </div>
</div>
