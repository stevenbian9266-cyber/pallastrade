<% content_for(:title, PallasTrade.t('admin.orders.transactions')) %>
<% content_for :page_title do %>
  <%= PallasTrade.t('admin.orders.transactions') %>
<% end %>

<div class="alert alert-info mb-6">
  <%= PallasTrade.t('admin.orders.transactions_help') %>
</div>

<% if @txn_metrics %>
  <div class="grid grid-cols-3 gap-4 mb-6" data-testid="txn-metrics">
    <div class="card">
      <div class="card-body">
        <div class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.transactions_recovery_required') %></div>
        <div class="text-2xl font-bold text-red-600"><%= @txn_metrics[:recovery_required] %></div>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.transactions_manual_review') %></div>
        <div class="text-2xl font-bold text-yellow-600"><%= @txn_metrics[:manual_review] %></div>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="text-sm text-gray-500"><%= PallasTrade.t('admin.orders.transactions_stuck') %></div>
        <div class="text-2xl font-bold text-gray-600"><%= @txn_metrics[:stuck] %></div>
      </div>
    </div>
  </div>
<% end %>

<%= render_table @collection, :transactions %>
