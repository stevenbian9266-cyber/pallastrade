<% if current_store.setup_task_done?(:setup_taxes_collection) %>
  <p><%= PallasTrade.t('admin.store_setup_tasks.taxes.done', link: PallasTrade.admin_tax_rates_path).html_safe %></p>
<% else %>
  <p><%= PallasTrade.t('admin.store_setup_tasks.taxes.copy') %></p>
  <div>
    <%= link_to PallasTrade.t('admin.store_setup_tasks.taxes.setup'), PallasTrade.admin_tax_rates_path, class: 'btn btn-primary', data: { turbo_frame: '_top' } %>
  </div>
<% end %>
