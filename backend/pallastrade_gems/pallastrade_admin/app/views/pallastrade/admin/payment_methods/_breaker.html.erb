<%# PALLAS-CUSTOM: D11 切片1（PRD-20260916-payments-d11）—— 熔断与健康卡（业务方案 §67.3）： %>
<%#   * 上：24h 健康指标（provider 级口径：尝试/失败/失败率/平均时长/主要错误） %>
<%#   * 下：逐入口状态（正常/已软置灰）+ 手动软置灰（必填原因 + 审计）/ 解除 %>
<% metrics = breaker_health_metrics(@payment_method) %>
<% rows = breaker_health_rows(@payment_method) %>

<div class="card mb-6" id="payment_method_breaker">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.payment_methods.breaker_health') %></h5>
  </div>
  <div class="card-body">
    <p class="form-text mb-3"><%= PallasTrade.t('admin.payment_methods.breaker_help') %></p>

    <table class="table mb-4">
      <thead>
        <tr>
          <th><%= PallasTrade.t('admin.payment_methods.breaker_window') %></th>
          <th><%= PallasTrade.t('admin.payment_methods.breaker_attempts') %></th>
          <th><%= PallasTrade.t('admin.payment_methods.breaker_failed') %></th>
          <th><%= PallasTrade.t('admin.payment_methods.breaker_failure_rate') %></th>
          <th><%= PallasTrade.t('admin.payment_methods.breaker_avg_seconds') %></th>
          <th><%= PallasTrade.t('admin.payment_methods.breaker_top_errors') %></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= metrics[:window] %></td>
          <td><%= metrics[:attempts] %></td>
          <td><%= metrics[:failed] %></td>
          <td><%= breaker_failure_rate_label(metrics) %></td>
          <td><%= breaker_average_seconds_label(metrics) %></td>
          <td class="text-gray-600"><%= breaker_top_error_codes_label(metrics) %></td>
        </tr>
      </tbody>
    </table>

    <% if rows.any? %>
      <table class="table mb-0">
        <thead>
          <tr>
            <th><%= PallasTrade.t('admin.payment_methods.breaker_entry') %></th>
            <th><%= PallasTrade.t('admin.payment_methods.breaker_status') %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr id="payment_method_breaker_<%= row['kind'] %>">
              <td><%= row['display_name'] %></td>
              <td>
                <% if row['disabled'] %>
                  <span class="badge badge-danger">
                    <%= PallasTrade.t('admin.payment_methods.breaker_status_disabled') %>
                  </span>
                  <div class="text-gray-600"><%= breaker_window_label(row) %></div>
                <% else %>
                  <span class="badge badge-success">
                    <%= PallasTrade.t('admin.payment_methods.breaker_status_enabled') %>
                  </span>
                <% end %>
              </td>
              <td class="text-end">
                <% if row['disabled'] %>
                  <%= link_to PallasTrade.t('admin.payment_methods.breaker_enable_action'),
                              PallasTrade.soft_enable_admin_payment_method_path(@payment_method, kind: row['kind']),
                              class: 'btn btn-sm btn-outline-secondary',
                              data: { turbo_method: :post,
                                      turbo_confirm: PallasTrade.t('admin.payment_methods.breaker_confirm') } %>
                <% else %>
                  <%= form_with url: PallasTrade.soft_disable_admin_payment_method_path(@payment_method),
                                method: :post, local: true, class: 'd-flex gap-2 justify-content-end' do |f| %>
                    <%= hidden_field_tag :kind, row['kind'] %>
                    <%= text_field_tag :reason, nil,
                                       class: 'form-control form-control-sm',
                                       placeholder: PallasTrade.t('admin.payment_methods.breaker_reason_placeholder'),
                                       'aria-label' => PallasTrade.t('admin.payment_methods.breaker_reason') %>
                    <%= submit_tag PallasTrade.t('admin.payment_methods.breaker_disable_action'),
                                   class: 'btn btn-sm btn-outline-danger text-nowrap',
                                   data: { turbo_confirm: PallasTrade.t('admin.payment_methods.breaker_confirm'),
                                           testid: 'breaker-soft-disable-save' } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="form-text mb-0"><%= PallasTrade.t('admin.payment_methods.breaker_none') %></p>
    <% end %>
  </div>
</div>
