<%# PALLAS-CUSTOM: PAY-CORE-P0A（PRD-20260920-checkout 支付核心统一 · 切片 P0-A）——
    厂商配置诊断卡（**只读**）：三态 / 能力来源 / 账户来源 / 「能力 ∩ 账户 ∩ 市场」收窄结论 / 诊断项。
    数据来自 `PaymentMethod#provider_diagnostics` + `Providers::{Config,Validate}`（零写入、零网络）。 %>
<% diagnostics = provider_diagnostics(@object) %>
<div class="card mb-6" data-testid="provider-diagnostics">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0"><%= PallasTrade.t('admin.payment_methods.provider_diagnostics.title') %></h5>
    <span class="badge <%= diagnostics[:state] == 'enabled' ? 'badge-success' : 'badge-danger' %>"
          data-testid="provider-diagnostics-state"><%= diagnostics[:state_label] %></span>
  </div>
  <div class="card-body">
    <p class="form-text mb-3"><%= PallasTrade.t('admin.payment_methods.provider_diagnostics.help') %></p>

    <dl class="row mb-3" data-testid="provider-diagnostics-rows">
      <% diagnostics[:rows].each do |row| %>
        <dt class="col-sm-4 text-sm" data-testid="provider-diagnostics-<%= row[:testid] %>-label"><%= row[:label] %></dt>
        <dd class="col-sm-8 text-sm" data-testid="provider-diagnostics-<%= row[:testid] %>"><%= row[:value] %></dd>
      <% end %>
    </dl>

    <% if diagnostics[:issues].any? %>
      <ul class="list-unstyled mb-0" data-testid="provider-diagnostics-issues">
        <% diagnostics[:issues].each do |issue| %>
          <li class="mb-1 text-sm" data-severity="<%= issue[:severity] %>">
            <span class="badge <%= issue[:severity] == 'error' ? 'badge-danger' : 'badge-light border' %>">
              <%= PallasTrade.t("admin.payment_methods.provider_diagnostics.severities.#{issue[:severity]}") %>
            </span>
            <span data-testid="provider-diagnostics-issue-<%= issue[:severity] %>"><%= issue[:message] %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm mb-0" data-testid="provider-diagnostics-consistent">
        <%= PallasTrade.t('admin.payment_methods.provider_diagnostics.consistent') %>
      </p>
    <% end %>

    <%# PALLAS-CUSTOM: PAY-CORE-P0B（PRD-20260920-checkout 切片 P0-B）—— 账户配置写入口：
        登记「本商家账户已开通的方式/币种/国家」，让「能力 ∩ 账户 ∩ 市场」收窄真正生效。
        留空一项 = 该维度未声明（不收窄）；越界值由服务端忽略并回显。 %>
    <hr class="my-3">
    <% account_form = provider_account_form(@object) %>
    <%= form_with url: PallasTrade.update_provider_account_admin_payment_method_path(@object), method: :post do |builder| %>
      <h6 class="mb-2"><%= PallasTrade.t('admin.payment_methods.provider_diagnostics.account_form_title') %></h6>
      <p class="form-text"><%= PallasTrade.t('admin.payment_methods.provider_diagnostics.account_form_help') %></p>
      <div class="row" data-testid="provider-account-form">
        <% %w[methods currencies countries].each do |dimension| %>
          <div class="col-sm-4 mb-2">
            <label class="form-label" for="provider_account_<%= dimension %>">
              <%= PallasTrade.t("admin.payment_methods.provider_diagnostics.dimensions.#{dimension}") %>
            </label>
            <%= select_tag "provider_account[#{dimension}][]",
                           options_for_select(account_form[:allowed][dimension], account_form[:selected][dimension]),
                           multiple: true,
                           id: "provider_account_#{dimension}",
                           class: 'form-select',
                           data: { testid: "provider-account-#{dimension}" } %>
          </div>
        <% end %>
      </div>
      <%= builder.submit PallasTrade.t('admin.payment_methods.provider_diagnostics.account_save'),
                         class: 'btn btn-primary mt-2',
                         data: { testid: 'provider-account-save' } %>
    <% end %>

    <%# PALLAS-CUSTOM: S1（PRD-20260915-admin §1.1 / FR-013）—— 移除 P3-C「支付路由」预览区块。
        理由：「多厂商之间谁承接」不属于「单厂商配置」页，且其结论只在订单上下文才有意义
        （预览本身 order_gates: 'skipped'）。**路由引擎保留**（`Payments::Routing::{Decide,Policy,Summary}`
        与路由引擎均已删除）—— 移除的只是后台展示面。 %>
  </div>
</div>
