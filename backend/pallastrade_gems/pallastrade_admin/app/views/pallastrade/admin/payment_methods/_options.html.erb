<%# PALLAS-CUSTOM: PAY-OPT-1（PRD-20260915-admin 切片3）—— 「支付方式」页签（能力目录表，FR-001/002/004）。
    表单结构 payment_method[payment_options][<kind>][active|display_name|position]，
    由 PallasTrade::Admin::PaymentMethodsController 归一写入 metadata['options'] / ['optionized']。
    勾选任一入口并保存后才置 optionized（未选项化 → 前台仍按单一默认入口，零回归）。 %>
<% option_rows = payment_option_rows(@payment_method) %>
<% scope_sources = payment_option_scope_sources(@payment_method) %>
<% last_check = @payment_method.metadata&.[]('last_test_connection') %>
<%# PALLAS-CUSTOM: S1（PRD-20260915-admin §1.1 / FR-011）—— 专用版面（provider 声明
    `provider_page_partial_name`，如 Stripe）把 [测试连接] 与结果移到页首「连接」卡；
    本卡仅在**通用版面**下继续承载按钮与结果（非 Stripe provider 零回归）。 %>
<% show_test_connection = @payment_method.provider_page_partial_name.blank? %>

<div class="card mb-6" data-testid="payment-options">
  <div class="card-header flex items-center justify-between">
    <h5 class="card-title mb-0"><%= PallasTrade.t('admin.payment_methods.payment_options') %></h5>
    <% if show_test_connection %>
      <%= link_to PallasTrade.t('admin.payment_methods.test_connection'),
                  PallasTrade.test_connection_admin_payment_method_path(@payment_method),
                  class: 'btn btn-secondary btn-sm',
                  data: { turbo_method: :post, turbo_frame: '_top', testid: 'options-test-connection' } %>
    <% end %>
  </div>
  <div class="card-body">
    <p class="text-gray-600 mb-4"><%= PallasTrade.t('admin.payment_methods.payment_options_help') %></p>

    <% if @payment_method.optionized? %>
      <div class="alert alert-info mb-4">
        <%= PallasTrade.t('admin.payment_methods.payment_options_optionized',
                          total: @payment_method.available_payment_options.size) %>
      </div>
    <% else %>
      <div class="alert alert-info mb-4"><%= PallasTrade.t('admin.payment_methods.payment_options_not_optionized') %></div>
    <% end %>

    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col"><%= PallasTrade.t('admin.payment_methods.payment_option_method') %></th>
            <th scope="col"><%= PallasTrade.t(:active) %></th>
            <th scope="col"><%= PallasTrade.t('admin.payment_methods.payment_option_display_name') %></th>
            <th scope="col"><%= PallasTrade.t('admin.payment_methods.payment_option_position') %></th>
            <th scope="col"><%= PallasTrade.t('admin.payment_methods.payment_option_frontend_kind') %></th>
            <%# PALLAS-CUSTOM: D15 切片3（PRD-20260917-checkout-d15-切片3）—— 入口能否被强制认证（只读） %>
            <th scope="col">
              <%= PallasTrade.t('admin.payment_methods.payment_option_three_d_secure') %>
              <i class="ti ti-info-circle" title="<%= PallasTrade.t('admin.payment_methods.payment_option_three_d_secure_help') %>"></i>
            </th>
            <%# PALLAS-CUSTOM: D8（PRD-20260915-payments-d8 切片2）—— 入口「适用范围」（市场/国家/Zone/币种） %>
            <th scope="col"><%= PallasTrade.t('admin.payment_methods.payment_option_scope') %></th>
          </tr>
        </thead>
        <tbody>
          <% option_rows.each do |row| %>
            <% field_name = "payment_method[payment_options][#{row[:kind]}]" %>
            <% switch_id = "payment_option_active_#{@payment_method.id}_#{row[:kind]}" %>
            <tr>
              <td class="whitespace-normal">
                <span class="badge badge-light border"><%= row[:kind] %></span>
              </td>
              <td>
                <div class="custom-control custom-switch">
                  <%= hidden_field_tag "#{field_name}[active]", '0', id: nil %>
                  <%= check_box_tag "#{field_name}[active]", '1', row[:active], class: 'custom-control-input', id: switch_id %>
                  <%= label_tag "#{field_name}[active]", '&nbsp;'.html_safe, class: 'custom-control-label', for: switch_id %>
                </div>
              </td>
              <td>
                <%= text_field_tag "#{field_name}[display_name]", row[:display_name], class: 'form-input' %>
              </td>
              <td class="w-20">
                <%= number_field_tag "#{field_name}[position]", row[:position], min: 0, class: 'form-input' %>
              </td>
              <td class="whitespace-normal">
                <span class="text-gray-600">
                  <%= PallasTrade.t("admin.payment_methods.frontend_kind_#{row[:frontend_kind]}", default: row[:frontend_kind]) %>
                </span>
              </td>
              <td class="whitespace-normal" data-payment-option-three-d-secure="<%= row[:three_d_secure] %>">
                <span class="badge <%= row[:three_d_secure] ? 'badge-success' : 'badge-light border' %>">
                  <%= row[:three_d_secure] ? PallasTrade.t('admin.payment_methods.payment_option_three_d_secure_yes') :
                                             PallasTrade.t('admin.payment_methods.payment_option_three_d_secure_unsupported') %>
                </span>
              </td>
              <td class="whitespace-normal">
                <div class="text-gray-600 mb-1"><%= row[:scope_summary] %></div>
                <%# 标记「范围区已渲染并提交」：全空选择也要能清空规则（否则与「未提交」无法区分） %>
                <%= hidden_field_tag "#{field_name}[rule_set][present]", '1', id: nil %>
                <div class="grid grid-cols-2 gap-2">
                  <% %i[market country zone currency].each do |dimension| %>
                    <label class="block">
                      <span class="text-gray-600 text-sm"><%= PallasTrade.t("admin.payment_methods.scope_#{dimension}") %></span>
                      <%= select_tag "#{field_name}[rule_set][#{dimension}][]",
                                     options_for_select(scope_sources[dimension], row[:scope_form_values][dimension]),
                                     multiple: true, size: 3, class: 'form-select form-select-sm' %>
                    </label>
                  <% end %>
                </div>
                <p class="form-text mb-0"><%= PallasTrade.t('admin.payment_methods.scope_help') %></p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if show_test_connection && last_check.present? %>
      <p class="text-gray-600 mt-2">
        <%= PallasTrade.t('admin.payment_methods.last_test_connection') %>:
        <span class="badge <%= last_check['ok'] ? 'badge-success' : 'badge-danger' %>">
          <%= last_check['ok'] ? PallasTrade.t(:say_yes) : PallasTrade.t(:say_no) %>
        </span>
        <%= "#{last_check['code']} · #{last_check['checked_at']}" %>
        <% if last_check['message'].present? %>
          <br /><%= last_check['message'] %>
        <% end %>
      </p>
    <% end %>
  </div>
</div>
