<%# PALLAS-CUSTOM: D9（PRD-20260915-payments-d9 切片2）—— 凭据健康卡 + Webhook 卡（业务方案 §68.2/§68.6）： %>
<%#   * 凭据健康：分级 / 最近轮换 / 到期日 / 告警级别 + reveal（owner 权限 + 审计，不落值） %>
<%#   * Webhook：端点 URL（可直接复制）+ 签名密钥只读掩码 %>
<% rows = credential_health_rows(@payment_method) %>
<% alerts = rows.reject { |row| row['alert_level'] == 'none' } %>
<% masked = masked_password_preferences(@payment_method) %>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.payment_methods.credential_health') %></h5>
  </div>
  <div class="card-body">
    <% alerts.each do |row| %>
      <div class="alert alert-warning mb-2">
        <%= PallasTrade.t('admin.payment_methods.credential_alert',
                          key: PallasTrade.t(row['key'], default: row['key'].to_s.humanize),
                          level: row['alert_level'],
                          days: row['days_left']) %>
      </div>
    <% end %>

    <% if rows.any? %>
      <table class="table">
        <thead>
          <tr>
            <th><%= PallasTrade.t('admin.payment_methods.credential_key') %></th>
            <th><%= PallasTrade.t('admin.payment_methods.credential_level') %></th>
            <th><%= PallasTrade.t('admin.payment_methods.credential_rotated_at') %></th>
            <th><%= PallasTrade.t('admin.payment_methods.credential_expires_on') %></th>
            <th><%= PallasTrade.t('admin.payment_methods.credential_value') %></th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <% key = row['key'].to_sym %>
            <tr>
              <td><%= PallasTrade.t(key, default: key.to_s.humanize) %></td>
              <td><%= PallasTrade.t("admin.payment_methods.credential_level_#{row['level']}", default: row['level']) %></td>
              <td><%= row['rotated_at'].presence || '—' %></td>
              <td>
                <%= row['expires_on'].presence || '—' %>
                <% if row['days_left'] %>
                  <span class="text-gray-600">(<%= PallasTrade.t('admin.payment_methods.credential_days_left', days: row['days_left']) %>)</span>
                <% end %>
              </td>
              <td>
                <span id="credential_value_<%= key %>">
                  <%= masked.fetch(key, PallasTrade.t('admin.payment_methods.credential_not_set')) %>
                </span>
                <%# reveal：POST + 二次确认（Turbo 栈）；明文只在服务端解析后一次性回显（写审计） %>
                <%= link_to PallasTrade.t('admin.payment_methods.reveal_credential'),
                            PallasTrade.reveal_credential_admin_payment_method_path(@payment_method, key: key),
                            class: 'btn btn-sm btn-outline-secondary ms-2',
                            data: { turbo_method: :post,
                                    turbo_confirm: PallasTrade.t('admin.payment_methods.reveal_credential_confirm') } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="form-text mb-0"><%= PallasTrade.t('admin.payment_methods.credential_none') %></p>
    <% end %>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t('admin.payment_methods.webhook_settings') %></h5>
  </div>
  <div class="card-body">
    <p class="form-text mb-1"><%= PallasTrade.t('admin.payment_methods.webhook_endpoint_help') %></p>
    <input type="text" class="form-input mb-3" readonly value="<%= payment_webhook_endpoint_url(@payment_method) %>">

    <% keys = payment_webhook_signing_keys(@payment_method) %>
    <% if keys.any? %>
      <p class="form-text mb-1"><%= PallasTrade.t('admin.payment_methods.webhook_signing_keys') %></p>
      <ul class="mb-0">
        <% keys.each do |key| %>
          <li><%= PallasTrade.t('admin.payment_methods.webhook_signing_key', value: masked_webhook_signing_key(key)) %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="form-text mb-0"><%= PallasTrade.t('admin.payment_methods.webhook_signing_key_none') %></p>
    <% end %>
  </div>
</div>
