<% if @object.respond_to?(:configuration_guide_partial_name) %>
  <%= render "pallastrade/admin/payment_methods/configuration_guides/#{@object.configuration_guide_partial_name}", f: f %>
<% end %>

<%# PALLAS-CUSTOM: PAY-CORE-P0A（PRD-20260920-checkout 切片 P0-A）—— 厂商配置诊断（只读）。
    S0（2026-09-20）起**由 `edit.html.erb` 在主表单之外渲染**（卡内「账户配置」是独立 POST 表单，
    落在主表单内部会构成嵌套 <form> → 提交归属错乱）。此处不再重复渲染。
    新记录未持久化（无 store/metadata）时本来也不显示。 %>

<% if !preference_fields(@object, f).empty? || @object.respond_to?(:custom_form_fields_partial_name) %>
  <div class="card mb-6">
    <div class="card-header">
      <h5 class="card-title"><%= PallasTrade.t(:payment_provider_settings) %></h5>
    </div>
    <div class="card-body">
      <%# PALLAS-CUSTOM: S1（PRD-20260915-admin §1.1）—— 凭证块抽出为 `_provider_settings`，
          与 Stripe 专用版面共用（后者放进「连接」卡）。 %>
      <%= render 'pallastrade/admin/payment_methods/provider_settings', f: f %>
    </div>
  </div>
<% end %>

<%# PALLAS-CUSTOM: S1（PRD-20260915-admin §1.1）—— 显示设置抽出为 `_display_settings`；
    通用版面含「环境」（与 D9 行为一致），Stripe 版面传 show_environment: false。 %>
<%= render 'pallastrade/admin/payment_methods/display_settings', f: f %>