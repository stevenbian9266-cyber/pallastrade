<% if @object.respond_to?(:configuration_guide_partial_name) %>
  <%= render "pallastrade/admin/payment_methods/configuration_guides/#{@object.configuration_guide_partial_name}", f: f %>
<% end %>

<%# PALLAS-CUSTOM: PAY-CORE-P0A（PRD-20260920-checkout 切片 P0-A）—— 厂商配置诊断（只读）。
    新记录未持久化（无 store/metadata）→ 不渲染。 %>
<% if @object.persisted? %>
  <%= render 'pallastrade/admin/payment_methods/provider_diagnostics' %>
<% end %>

<% if !preference_fields(@object, f).empty? || @object.respond_to?(:custom_form_fields_partial_name) %>
  <div class="card mb-6">
    <div class="card-header">
      <h5 class="card-title"><%= PallasTrade.t(:payment_provider_settings) %></h5>
    </div>
    <div class="card-body">
      <%= preference_fields(@object, f) unless preference_fields(@object, f).empty? %>

      <%# PALLAS-CUSTOM: PAY-OPT-1（PRD-20260915 切片3）—— 凭证脱敏回显（FR-006）：
          只显示掩码（•••• + 后 4 位），页面不落明文；留空保持不变。 %>
      <% masked_preferences = masked_password_preferences(@object) %>
      <% if masked_preferences.any? %>
        <div class="mt-2">
          <% masked_preferences.each do |key, masked| %>
            <p class="form-text mb-1">
              <%= PallasTrade.t('admin.payment_methods.credential_masked',
                                name: PallasTrade.t(key, default: key.to_s.humanize), value: masked) %>
            </p>
          <% end %>
        </div>
      <% end %>

      <% if @object.respond_to?(:custom_form_fields_partial_name) %>
        <%= render "pallastrade/admin/payment_methods/custom_form_fields/#{@object.custom_form_fields_partial_name}", f: f %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t(:display_settings) %></h5>
  </div>
  <div class="card-body">
    <%= f.pallastrade_text_field :name, help: PallasTrade.t('admin.payment_methods.name_help') %>

    <%= f.pallastrade_select :display_on, display_on_options, { label: PallasTrade.t(:display) } %>
    <%# PALLAS-CUSTOM: D9（PRD-20260915-payments-d9 切片2）—— 环境（test / live）：
        切到 test 即不进前台（业务方案 §68.1）；保存即生效，不重启不重建镜像。 %>
    <%= f.pallastrade_select :environment, environment_options, { label: PallasTrade.t('admin.payment_methods.environment'), help: PallasTrade.t('admin.payment_methods.environment_help') } %>
    <%= f.pallastrade_select :auto_capture, [["#{PallasTrade.t(:use_app_default)} (#{PallasTrade::Config[:auto_capture]})", ''], [PallasTrade.t(:say_yes).to_s, true], [PallasTrade.t(:say_no).to_s, false]], { label: PallasTrade.t(:auto_capture) } %>

    <%= f.pallastrade_check_box :active %>
  </div>
</div>