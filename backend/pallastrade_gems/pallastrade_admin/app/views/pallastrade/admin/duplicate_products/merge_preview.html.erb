<% content_for :page_title do %>
  <%= PallasTrade.t('admin.duplicate_products.merge.title') %>
<% end %>

<div class="alert alert-info mb-6" data-testid="merge-preview-heading">
  <div class="font-medium">
    <%= PallasTrade.t('admin.duplicate_products.merge.heading',
                      survivor: @survivor.name, absorbed: @absorbed.name) %>
  </div>
  <div class="text-gray-500 text-sm"><%= PallasTrade.t('admin.duplicate_products.merge.disclaimer') %></div>
</div>

<% if @existing_merge %>
  <div class="alert alert-warning mb-6" data-testid="merge-already-active">
    <%= PallasTrade.t('admin.duplicate_products.merge.already_active') %>
  </div>
<% end %>

<div class="card-lg mb-6">
  <div class="card-header">
    <h3 class="card-title"><%= PallasTrade.t('admin.duplicate_products.merge.impact_heading') %></h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table mb-0" data-testid="merge-impact">
        <thead>
          <tr>
            <th><%= PallasTrade.t('admin.duplicate_products.merge.section') %></th>
            <th class="text-center"><%= PallasTrade.t('admin.duplicate_products.merge.moves') %></th>
            <th class="text-center"><%= PallasTrade.t('admin.duplicate_products.merge.skips') %></th>
          </tr>
        </thead>
        <tbody>
          <% @preview.counts.each do |section, counts| %>
            <tr data-testid="merge-impact-row" data-section="<%= section %>">
              <td><%= PallasTrade.t("admin.duplicate_products.merge.sections.#{section}") %></td>
              <td class="text-center"><%= counts['move'] %></td>
              <td class="text-center"><%= counts['skip'] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @preview.skipped.any? %>
  <div class="card-lg mb-6">
    <div class="card-header">
      <h3 class="card-title"><%= PallasTrade.t('admin.duplicate_products.merge.skipped_heading') %></h3>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0" data-testid="merge-skipped">
          <thead>
            <tr>
              <th><%= PallasTrade.t('admin.duplicate_products.merge.section') %></th>
              <th><%= PallasTrade.t('admin.duplicate_products.merge.reason') %></th>
              <th><%= PallasTrade.t('admin.duplicate_products.merge.detail') %></th>
            </tr>
          </thead>
          <tbody>
            <% @preview.skipped.each do |item| %>
              <tr data-testid="merge-skipped-row" data-reason="<%= item[:reason] %>">
                <td><%= PallasTrade.t("admin.duplicate_products.merge.sections.#{item[:section]}") %></td>
                <td><%= PallasTrade.t("admin.duplicate_products.merge.reasons.#{item[:reason]}", default: item[:reason]) %></td>
                <td><%= item[:label] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<div class="card-lg mb-6">
  <div class="card-header">
    <h3 class="card-title"><%= PallasTrade.t('admin.duplicate_products.merge.redirects_heading') %></h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table mb-0" data-testid="merge-redirects">
        <tbody>
          <% @preview.redirects.each do |pair| %>
            <tr data-testid="merge-redirect-row">
              <td><%= pair[:from_path] %></td>
              <td class="text-gray-400">→</td>
              <td><%= pair[:to_path] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @preview.historical[:line_items].positive? %>
  <p class="text-gray-500 mb-6" data-testid="merge-history-note">
    <%= PallasTrade.t('admin.duplicate_products.merge.history_note', count: @preview.historical[:line_items]) %>
  </p>
<% end %>

<%= form_with url: PallasTrade.admin_merge_duplicate_products_path, method: :post, data: { testid: 'merge-form' } do %>
  <%= hidden_field_tag :survivor_id, @survivor.prefixed_id %>
  <%= hidden_field_tag :absorbed_id, @absorbed.prefixed_id %>
  <%= submit_tag PallasTrade.t('admin.duplicate_products.merge.confirm'),
                 class: 'btn btn-primary', data: { testid: 'merge-confirm' } %>
  <%= link_to PallasTrade.t('admin.duplicate_products.merge.cancel'),
              PallasTrade.admin_duplicate_products_path,
              class: 'btn btn-light ml-2' %>
<% end %>
