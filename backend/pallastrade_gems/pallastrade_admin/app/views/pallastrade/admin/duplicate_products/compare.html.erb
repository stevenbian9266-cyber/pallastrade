<% content_for :page_title do %>
  <%= PallasTrade.t('admin.duplicate_products.compare_title') %>
<% end %>

<p class="text-gray-500 mb-6"><%= PallasTrade.t('admin.duplicate_products.compare_intro') %></p>

<% if @products.size < 2 %>
  <p class="text-gray-500" data-testid="compare-empty"><%= PallasTrade.t('admin.duplicate_products.compare_empty') %></p>
<% else %>
  <div class="card-lg">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table mb-0" data-testid="duplicate-comparison">
          <thead>
            <tr>
              <th><%= PallasTrade.t('admin.duplicate_products.attribute') %></th>
              <% @products.each do |product| %>
                <th>
                  <%= link_to product.name, PallasTrade.edit_admin_product_path(product) %>
                  <div class="text-gray-500 text-sm"><%= product.slug %></div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @rows.each do |row| %>
              <tr data-testid="compare-row" data-attribute="<%= row[:label_key] %>">
                <th class="font-medium"><%= PallasTrade.t("admin.duplicate_products.attributes.#{row[:label_key]}") %></th>
                <% row[:values].each do |value| %>
                  <td><%= value.presence || PallasTrade.t('admin.duplicate_products.blank_value') %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<%# D-3 切片1（PRD-20260916-catalog-d3-product-merge FR-007）：合并入口。
    先选「保留哪个 / 合并哪个」，再进预检页看清影响面 —— 这里不写任何数据。 %>
<% if @products.size >= 2 %>
  <div class="card-lg mt-6" data-testid="merge-entry">
    <div class="card-header">
      <h3 class="card-title"><%= PallasTrade.t('admin.duplicate_products.merge.entry_heading') %></h3>
    </div>
    <div class="card-body">
      <p class="text-gray-500 mb-4"><%= PallasTrade.t('admin.duplicate_products.merge.entry_help') %></p>
      <%= form_with url: PallasTrade.admin_merge_duplicate_products_path, method: :get, data: { testid: 'merge-entry-form' } do %>
        <div class="mb-3">
          <div class="font-medium"><%= PallasTrade.t('admin.duplicate_products.merge.keep_label') %></div>
          <% @products.each_with_index do |product, index| %>
            <label class="flex items-center gap-2 mt-1">
              <%= radio_button_tag :survivor_id, product.prefixed_id, index.zero?, data: { testid: 'merge-survivor-option' } %>
              <span><%= product.name %> <span class="text-gray-500 text-sm"><%= product.slug %></span></span>
            </label>
          <% end %>
        </div>
        <div class="mb-3">
          <div class="font-medium"><%= PallasTrade.t('admin.duplicate_products.merge.absorb_label') %></div>
          <% @products.each_with_index do |product, index| %>
            <label class="flex items-center gap-2 mt-1">
              <%= radio_button_tag :absorbed_id, product.prefixed_id, index == 1, data: { testid: 'merge-absorbed-option' } %>
              <span><%= product.name %> <span class="text-gray-500 text-sm"><%= product.slug %></span></span>
            </label>
          <% end %>
        </div>
        <%= submit_tag PallasTrade.t('admin.duplicate_products.merge.preview_button'),
                       class: 'btn btn-primary', data: { testid: 'merge-preview-submit' } %>
      <% end %>
    </div>
  </div>
<% end %>
