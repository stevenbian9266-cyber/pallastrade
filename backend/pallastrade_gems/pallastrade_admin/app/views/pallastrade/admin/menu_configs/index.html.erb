<% content_for(:page_title) do %>
  <%= PallasTrade.t('admin.menu_configs.title') %>
<% end %>

<%# PALLAS-CUSTOM: 菜单配置只读可视化（2026-08-17 方向收敛）
    —— 菜单结构由代码导航配置定义，本页仅只读展示导航树，让用户直观感受；
    权限配置依据在 Roles 页「菜单权限」树状勾选（与本站同一导航树）。 %>
<div class="card mb-6">
  <div class="card-header">
    <h5 class="mb-0"><%= PallasTrade.t('admin.menu_configs.title') %></h5>
  </div>
  <div class="card-body">
    <p class="text-sm text-gray-500 mb-4"><%= PallasTrade.t('admin.menu_configs.readonly_help') %></p>

    <ul class="space-y-3">
      <% @nav_root_items.each do |item| %>
        <% next if item.section? %>
        <li class="border rounded-md p-3">
          <div class="flex items-center gap-2 flex-wrap">
            <%= icon(item.icon, class: 'icon text-gray-400') if item.icon %>
            <span class="font-medium"><%= item.resolve_label %></span>
            <% if item.landing && item.landing_item %>
              <span class="badge badge-info text-xs"><%= PallasTrade.t('admin.menu_configs.landing') %>: <%= item.landing_item.resolve_label %></span>
            <% end %>
            <% url = item.safe_resolve_url(self) %>
            <code class="text-xs text-gray-500"><%= url %></code>
          </div>

          <% if item.children.any? %>
            <ul class="ml-6 mt-2 flex flex-col gap-1">
              <% item.children.each do |child| %>
                <li class="flex items-center gap-2 text-sm">
                  <%= icon(child.icon, class: 'icon text-gray-400') if child.icon %>
                  <span><%= child.resolve_label %></span>
                  <% child_url = child.safe_resolve_url(self) %>
                  <code class="text-xs text-gray-500"><%= child_url %></code>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
