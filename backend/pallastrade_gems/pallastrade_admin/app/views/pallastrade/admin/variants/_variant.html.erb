<% cache variant do %>
  <% if variant.is_master? || variant.product.deleted? %>
    <% variant_url = PallasTrade.edit_admin_product_path(variant.product) %>
  <% else %>
    <% variant_url = PallasTrade.edit_admin_product_variant_path(variant.product, variant) %>
  <% end %>

  <%= link_to variant_url, id: dom_id(variant, 'pallastrade'), data: { turbo_permanent: true, turbo_frame: :_top }, class: 'flex items-center justify-start no-underline gap-2' do %>
    <%= render "pallastrade/admin/shared/product_image", object: variant %>
    <div class="ml-6">
      <strong><%= variant.name %></strong>
      <% if !variant.is_master? && variant.options_text.present? %>
        <p class="text-gray-600 my-1 text-sm">
          <%= variant.options_text %>
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
