<%= turbo_frame_tag :dialog do %>
  <%= form_with model: @promotion_rule, url: PallasTrade.admin_promotion_rules_path(@promotion), method: :post, scope: :promotion_rule do |f| %>
    <% if @promotion_rule.type.nil? %>
      <%= dialog_header(PallasTrade.t(:add_rule_of_type)) %>
    <% else %>
      <%= dialog_header(@promotion_rule.human_name) %>
    <% end %>
    <div class="dialog-body <% if @promotion_rule.type.present? %>overflow-visible<% end %>">
      <%= render partial: 'pallastrade/admin/shared/error_messages', locals: { target: @promotion_rule } %>
      <% if @promotion_rule.type.nil? %>
        <% promotion_rule_entries(@promotion).each do |entry| %>
          <%= link_to PallasTrade.new_admin_promotion_rule_path(@promotion, promotion_rule: { type: entry.type }), class: 'flex align-items-top w-full py-2 px-4 hover:bg-gray-100 rounded-xl mb-2 no-underline', data: { turbo_prefetch: false } do %>
            <%= radio_button_tag :type, entry.type, class: 'hidden' %>
            <div>
              <h6 class="font-bold mb-1"><%= entry.label %></h6>
              <p class="text-gray-600 mb-0"><%= entry.description %></p>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-gray-600 mb-3">
          <%= @promotion_rule.human_description %>
        </p>
        <%= f.hidden_field :type, value: @promotion_rule.type %>
        <%= render promotion_rule_form_partial(@promotion_rule), f: f %>
      <% end %>
    </div>
    <% if @promotion_rule.type.present? %>
      <div class="dialog-footer">
        <%= dialog_discard_button %>
        <%= turbo_save_button_tag PallasTrade.t('actions.create'), data: { turbo_frame: '_top' } %>
      </div>
    <% end %>
  <% end %>
<% end %>