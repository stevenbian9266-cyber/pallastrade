<div class="card mb-6">
  <div class="card-body">
    <%= f.pallastrade_text_field :name, required: true, autofocus: f.object.new_record?, data: { seo_form_target: 'sourceTitleInput', slug_form_target: :name, action: 'slug-form#updateUrlFromName' } %>

    <%# PALLAS-CUSTOM: AI Product Copilot（PRD-20260915-catalog-batch-e1-ai-copilot FR-003/FR-005）
        描述生成/重写：Generate → Preview → Accept → Save，AI 不落库。ai_state 为 nil（未装 AI 引擎）时保持原样 %>
    <% ai_state = defined?(PallasTrade::AI::Catalog::ProductCopy) && f.object.persisted? ? ai_assist_state(PallasTrade::AI::Catalog::ProductCopy::DESCRIPTION_CAPABILITY) : nil %>
    <% ai_data = if ai_state
                    ai_assist_attributes(
                      endpoint: PallasTrade.admin_ai_product_description_path,
                      product_id: f.object.prefixed_id,
                      kind: 'description',
                      mode: 'generate'
                    )
                  else
                    {}
                  end %>
    <div class="form-group mb-0" <%= tag.attributes(ai_data) %>>
      <%= f.label :description, PallasTrade.t(:description) %>
      <div class="trix-container mb-0">
        <%= f.text_area :description, { rows: 10, class: "form-input pallastrade-rte", data: { seo_form_target: 'sourceDescriptionInput', ai_assist_target: 'field' } } %>
      </div>

      <% if ai_state %>
        <div class="flex flex-wrap items-center gap-2 mt-2">
          <button type="button" class="btn btn-light btn-sm" data-ai-assist-role="generate"
                  data-action="click->ai-assist#generate"
                  <% unless ai_state[:available] %>disabled title="<%= ai_assist_reason_label(ai_state) %>"<% end %>>
            <%= PallasTrade.t('admin.products.ai.generate') %>
          </button>
          <button type="button" class="btn btn-light btn-sm" data-ai-assist-role="generate"
                  data-action="click->ai-assist#generate" data-ai-assist-mode-param="rewrite"
                  <% unless ai_state[:available] %>disabled title="<%= ai_assist_reason_label(ai_state) %>"<% end %>>
            <%= PallasTrade.t('admin.products.ai.rewrite') %>
          </button>
          <span class="text-xs text-muted" data-ai-assist-target="status"></span>
        </div>

        <div class="hidden mt-3 border rounded p-3 bg-gray-25" data-ai-assist-target="preview" data-testid="ai-description-preview">
          <div class="font-medium text-sm mb-2"><%= PallasTrade.t('admin.products.ai.preview_heading') %></div>
          <div class="text-sm whitespace-pre-wrap" data-ai-assist-target="previewBody"></div>
          <div class="flex items-center gap-2 mt-3">
            <button type="button" class="btn btn-primary btn-sm" data-action="click->ai-assist#accept">
              <%= PallasTrade.t('admin.products.ai.accept') %>
            </button>
            <button type="button" class="btn btn-light btn-sm" data-action="click->ai-assist#discard">
              <%= PallasTrade.t('admin.products.ai.discard') %>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>