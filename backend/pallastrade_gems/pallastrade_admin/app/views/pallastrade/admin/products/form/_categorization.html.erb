<%# PALLAS-CUSTOM: Replaced single tom_select with 3-level cascade dropdowns. %>
<% if can?(:manage, PallasTrade::Classification) %>
  <% roots = PallasTrade::Taxon.for_store(current_store).roots.order(:name) %>
  <% all_categories = PallasTrade::Taxon.for_store(current_store).select(:id, :name, :parent_id) %>
  <div class="card mb-6" data-controller="category-cascade">
    <div class="card-header">
      <h5 class="card-title">
        <%= PallasTrade.t(:categorization) %>
        <span class="text-red-500">*</span>
      </h5>
    </div>
    <div class="card-body">
      <!-- Category name map + children map for Stimulus (avoids API calls) -->
      <script id="category-name-map" type="application/json">
        <%= raw all_categories.each_with_object({}) { |c, h| h[c.id] = c.name }.to_json %>
      </script>
      <script id="category-children-map" type="application/json">
        <%= raw all_categories.group_by(&:parent_id).transform_values { |v| v.map(&:id) }.to_json %>
      </script>

      <div class="flex gap-3 items-start">
        <% selected = @product.taxons.manual.first %>
        <% selected_parent = selected&.parent %>
        <% selected_grandparent = selected_parent&.parent %>

        <!-- Level 1 -->
        <div class="form-group flex-1">
          <label class="form-label">
            <%= PallasTrade.t('category_cascade.level1') %> <span class="text-red-500">*</span>
          </label>
          <select class="form-select w-full"
                  data-category-cascade-target="level1"
                  data-action="change->category-cascade#loadLevel2"
                  required>
            <option value=""><%= PallasTrade.t('category_cascade.select') %> <%= PallasTrade.t('category_cascade.level1') %></option>
            <% roots.each do |c| %>
              <option value="<%= c.id %>"
                      data-children="<%= (all_categories.select { |t| t.parent_id == c.id }.map(&:id)).to_json %>"
                      <%= 'selected' if selected_grandparent&.id == c.id || (!selected_parent && !selected_grandparent && selected&.root?) %>>
                <%= c.name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- Level 2 -->
        <div class="form-group flex-1">
          <label class="form-label"><%= PallasTrade.t('category_cascade.level2') %></label>
          <select class="form-select w-full"
                  data-category-cascade-target="level2"
                  data-action="change->category-cascade#loadLevel3"
                  <%= 'disabled' unless selected_parent || selected_grandparent %>>
            <option value=""><%= PallasTrade.t('category_cascade.select') %> <%= PallasTrade.t('category_cascade.level2') %></option>
            <% target_parent = selected_grandparent || (selected&.root? ? selected : nil) %>
            <% if target_parent %>
              <% target_parent.children.order(:name).each do |c| %>
                <option value="<%= c.id %>"
                        data-children="<%= (all_categories.select { |t| t.parent_id == c.id }.map(&:id)).to_json %>"
                        <%= 'selected' if c.id == selected_parent&.id || c.id == selected&.id %>>
                  <%= c.name %>
                </option>
              <% end %>
            <% end %>
          </select>
        </div>

        <!-- Level 3 -->
        <div class="form-group flex-1">
          <label class="form-label"><%= PallasTrade.t('category_cascade.level3') %></label>
          <select class="form-select w-full"
                  name="product[taxon_ids][]"
                  data-category-cascade-target="level3"
                  <%= 'disabled' unless selected_parent || (selected && !selected.root?) %>>
            <option value=""><%= PallasTrade.t('category_cascade.select') %> <%= PallasTrade.t('category_cascade.level3') %></option>
            <% target_parent = selected_parent || (selected && !selected.root? ? selected.parent : nil) %>
            <% if target_parent %>
              <% target_parent.children.order(:name).each do |c| %>
                <option value="<%= c.id %>" <%= 'selected' if c.id == selected&.id %>>
                  <%= c.name %>
                </option>
              <% end %>
            <% end %>
          </select>
        </div>
      </div>
    </div>
  </div>
<% end %>