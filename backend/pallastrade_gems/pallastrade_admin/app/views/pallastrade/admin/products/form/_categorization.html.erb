<%# PALLAS-CUSTOM: Replaced single tom_select with 3-level cascade dropdowns. %>
<% if can?(:manage, PallasTrade::Classification) %>
  <% roots = PallasTrade::Category.for_store(current_store).roots.order(:name) %>
  <%# PALLAS-CUSTOM: Use pluck to get raw column values — Mobility-translated
      # .select() strips the translation layer, returning nil for name.
      # name_map: {id => name}, children_map: {parent_id => [child_ids]} %>
  <% name_map = PallasTrade::Category.for_store(current_store).pluck(:id, :name).to_h
     children_map = PallasTrade::Category.for_store(current_store).where.not(parent_id: nil).pluck(:parent_id, :id).group_by(&:first).transform_values { |v| v.map(&:last) } %>
  <div class="card mb-6" data-controller="category-cascade">
    <div class="card-header">
      <h5 class="card-title">
        <%= PallasTrade.t(:categorization) %>
        <span class="text-red-500">*</span>
      </h5>
    </div>
    <div class="card-body">
      <script id="category-name-map" type="application/json">
        <%= raw name_map.to_json %>
      </script>
      <script id="category-children-map" type="application/json">
        <%= raw children_map.to_json %>
      </script>

      <%
        selected = @product.taxons.manual.first
        if selected
          ancestors = selected.self_and_ancestors.reject { |a| a.depth > 2 }
          level1_id = ancestors[0]&.id
          level2_id = ancestors[1]&.id
          level3_id = ancestors[2]&.id
        end
      %>

      <div class="flex gap-3 items-start">
        <!-- Level 1 -->
        <div class="form-group flex-1">
          <label class="form-label">
            <%= PallasTrade.t('category_cascade.level1') %> <span class="text-red-500">*</span>
          </label>
          <select class="form-select w-full"
                  data-category-cascade-target="level1"
                  data-action="change->category-cascade#loadLevel2"
                  required>
            <option value=""><%= PallasTrade.t('category_cascade.select') %> <%= PallasTrade.t('category_cascade.level1') %></option>
            <% roots.each do |c| %>
              <option value="<%= c.id %>"
                      data-children="<%= (children_map[c.id] || []).to_json %>"
                      <%= 'selected' if level1_id == c.id %>>
                <%= c.name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- Level 2 -->
        <div class="form-group flex-1">
          <label class="form-label"><%= PallasTrade.t('category_cascade.level2') %></label>
          <select class="form-select w-full"
                  data-category-cascade-target="level2"
                  data-action="change->category-cascade#loadLevel3"
                  <%= 'disabled' unless level2_id || level1_id %>>
            <option value=""><%= PallasTrade.t('category_cascade.select') %> <%= PallasTrade.t('category_cascade.level2') %></option>
            <% if level1_id %>
              <% PallasTrade::Category.find(level1_id).children.order(:name).each do |c| %>
                <option value="<%= c.id %>"
                        data-children="<%= (children_map[c.id] || []).to_json %>"
                        <%= 'selected' if level2_id == c.id %>>
                  <%= c.name %>
                </option>
              <% end %>
            <% end %>
          </select>
        </div>

        <!-- Level 3 -->
        <div class="form-group flex-1">
          <label class="form-label"><%= PallasTrade.t('category_cascade.level3') %></label>
          <select class="form-select w-full"
                  name="product[taxon_ids][]"
                  data-category-cascade-target="level3"
                  <%= 'disabled' unless level3_id || level2_id %>>
            <option value=""><%= PallasTrade.t('category_cascade.select') %> <%= PallasTrade.t('category_cascade.level3') %></option>
            <% if level2_id %>
              <% PallasTrade::Category.find(level2_id).children.order(:name).each do |c| %>
                <option value="<%= c.id %>" <%= 'selected' if level3_id == c.id %>>
                  <%= c.name %>
                </option>
              <% end %>
            <% end %>
          </select>
        </div>
      </div>
    </div>
  </div>
<% end %>