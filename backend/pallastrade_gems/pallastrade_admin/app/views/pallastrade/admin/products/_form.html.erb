<%# PALLAS-CUSTOM: Moved categorization above base form into main content area, removed from sidebar. %>
<div class="grid grid-cols-12 gap-6" data-controller="product-form slug-form seo-form" data-seo-form-editor-value="tinymce">
  <div class="col-span-12 md:col-span-8">
    <%# Categorization moved ABOVE name — 三级横向下拉，一级必填 %>
    <%= render 'pallastrade/admin/products/form/categorization', f: f %>

    <%= render 'pallastrade/admin/products/form/base', f: f %>
    <%= render 'pallastrade/admin/shared/media_form', viewable: @product, viewable_type: 'PallasTrade::Product' %>
    <%= f.fields_for :master, @product.master do |vf| %>
      <%= render 'pallastrade/admin/variants/form/pricing', f: vf %>
    <% end unless @product.has_variants? %>
    <%= render 'pallastrade/admin/products/form/variants', f: f %>
    <%= render 'pallastrade/admin/products/form/inventory', f: f unless @product.has_variants? %>
    <%= render_admin_partials(:product_form_partials, f: f, product: @product) %>
  </div>
  <div class="col-span-12 md:col-span-4">
    <%= render 'pallastrade/admin/products/form/status', f: f %>
    <%= render 'pallastrade/admin/products/form/publishing', f: f %>
    <%= render 'pallastrade/admin/products/form/shipping', f: f %>
    <%= render 'pallastrade/admin/products/form/tax', f: f %>
    <%= render_admin_partials(:product_form_sidebar_partials, f: f, product: @product) %>

    <%# PALLAS-CUSTOM: AI Product Copilot（FR-004/FR-006）—— 未安装 AI 引擎时为 nil，SEO 卡片保持原样 %>
    <% ai_seo_state = defined?(PallasTrade::AI::Catalog::ProductCopy) ? ai_assist_state(PallasTrade::AI::Catalog::ProductCopy::SEO_CAPABILITY) : nil %>
    <%= render 'pallastrade/admin/shared/seo',
          f: f,
          title: @product.name,
          meta_title: @product.meta_title,
          description: @product.description,
          slug: @product.slug,
          slug_path: 'products',
          placeholder: PallasTrade.t('admin.products.seo.placeholder'),
          ai_seo_state: ai_seo_state,
          ai_seo_product_id: (@product.persisted? ? @product.prefixed_id : nil) %>
  </div>
</div>