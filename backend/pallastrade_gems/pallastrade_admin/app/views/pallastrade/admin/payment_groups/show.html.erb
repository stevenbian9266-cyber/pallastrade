<%# PALLAS-CUSTOM: 多订单合并支付（PRD-20260823-checkout-多订单拆分与合并支付） %>
<% content_for :page_title do %>
  <%= page_header_back_button PallasTrade.admin_payment_groups_path, @payment_group %>
  <%= @payment_group.prefixed_id %>
  <span class="badge <%= @payment_group.status == 'completed' ? 'badge-success' : 'badge-info' %>">
    <%= @payment_group.status %>
  </span>
<% end %>

<div class="grid grid-cols-12 gap-6">
  <div class="col-span-12 lg:col-span-8">
    <div class="card mb-6">
      <div class="card-header">
        <h5 class="card-title"><%= PallasTrade.t(:orders) %></h5>
      </div>
      <div class="card-body p-0">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th><%= PallasTrade.t(:order) %></th>
              <th><%= PallasTrade.t(:number) %></th>
              <th class="text-right"><%= PallasTrade.t(:total) %></th>
              <th><%= PallasTrade.t(:payment_state) %></th>
            </tr>
          </thead>
          <tbody>
            <% @payment_group.orders.each do |order| %>
              <tr>
                <td>
                  <%= link_to order.number, PallasTrade.admin_order_path(order),
                              class: 'text-primary font-medium' %>
                </td>
                <td><%= order.number %></td>
                <td class="text-right">
                  <%= PallasTrade::Money.new(order.total, currency: order.currency) %>
                </td>
                <td>
                  <span class="badge <%= order.paid? ? 'badge-success' : 'badge-warning' %>">
                    <%= order.payment_state %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-span-12 lg:col-span-4">
    <div class="card mb-6">
      <div class="card-header">
        <h5 class="card-title"><%= PallasTrade.t(:summary) %></h5>
      </div>
      <div class="card-body">
        <dl class="mb-0">
          <dt><%= PallasTrade.t(:currency) %></dt>
          <dd><%= @payment_group.currency %></dd>
          <dt><%= PallasTrade.t(:amount) %></dt>
          <dd><%= PallasTrade::Money.new(@payment_group.amount, currency: @payment_group.currency) %></dd>
          <dt><%= PallasTrade.t(:status) %></dt>
          <dd><%= @payment_group.status %></dd>
          <% if @payment_group.completed_at.present? %>
            <dt><%= PallasTrade.t(:completed_at) %></dt>
            <dd><%= pallastrade_time_ago(@payment_group.completed_at) %></dd>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="card mb-6">
      <div class="card-header">
        <h5 class="card-title"><%= PallasTrade.t(:payment_sessions) %></h5>
      </div>
      <div class="card-body p-0">
        <% if @payment_group.payment_sessions.any? %>
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th><%= PallasTrade.t(:session) %></th>
                <th><%= PallasTrade.t(:status) %></th>
              </tr>
            </thead>
            <tbody>
              <% @payment_group.payment_sessions.each do |session| %>
                <tr>
                  <td><%= session.prefixed_id %></td>
                  <td>
                    <span class="badge badge-info"><%= session.status %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-6 text-center text-gray-500"><%= PallasTrade.t(:none) %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
