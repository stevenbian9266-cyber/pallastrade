<%# Desktop Sidebar %>
<aside id="main-sidebar" class="overflow-y-auto scrollbar-thin" data-sidebar-target="desktop">
  <% if defined?(current_vendor) && current_vendor.present? %>
    <%= render 'pallastrade/admin/shared/sidebar/vendor_dropdown' %>
  <% else %>
    <%= render 'pallastrade/admin/shared/sidebar/store_dropdown' %>
  <% end %>

  <div class="sidebar-content">
    <% if defined?(current_vendor) && current_vendor.present? %>
      <%= render 'pallastrade/admin/shared/sidebar/vendor_nav' %>
    <% else %>
      <%= render 'pallastrade/admin/shared/sidebar/store_nav' %>
    <% end %>
  </div>

  <%= render 'pallastrade/admin/shared/user_dropdown' %>
</aside>

<%# Mobile Sidebar Overlay %>
<div class="sidebar-mobile lg:hidden" data-sidebar-target="mobile">
  <div class="sidebar-backdrop" data-action="click->sidebar#closeMobile"></div>
  <div class="sidebar-panel">
    <div class="sidebar-mobile-header">
      <% if defined?(current_vendor) && current_vendor.present? %>
        <%= render 'pallastrade/admin/shared/sidebar/vendor_dropdown' %>
      <% else %>
        <%= render 'pallastrade/admin/shared/sidebar/store_dropdown' %>
      <% end %>
      <button type="button" class="btn btn-sm ms-auto" data-action="click->sidebar#closeMobile" aria-label="<%= PallasTrade.t('admin.close_sidebar') %>">
        <%= icon('x') %>
      </button>
    </div>
    <div class="sidebar-mobile-content">
      <% if defined?(current_vendor) && current_vendor.present? %>
        <%= render 'pallastrade/admin/shared/sidebar/vendor_nav' %>
      <% else %>
        <%= render 'pallastrade/admin/shared/sidebar/store_nav' %>
      <% end %>
    </div>

    <%= render 'pallastrade/admin/shared/user_dropdown' %>
  </div>
</div>