<%= render 'pallastrade/admin/shared/section_nav', section: :team %>

<% content_for :page_actions do %>
  <%= render_admin_partials(:admin_users_actions_partials) %>
<% end %>

<%= render_admin_partials(:admin_users_header_partials) %>

<div class="card-lg">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th scope="col" class="rounded-xl-top-left"><%= PallasTrade.t(:user) %></th>
          <th scope="col"><%= PallasTrade.t(:roles) %></th>
          <th scope="col" class="rounded-xl-top-right"><%= sort_link @search, :created_at, PallasTrade.t(:created_at) %></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: 'pallastrade/admin/admin_users/admin_user', collection: @collection %>
      </tbody>
    </table>
  </div>
</div>