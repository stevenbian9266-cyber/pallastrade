<%= render layout: 'pallastrade/shared/mailer_hero' do %>
  <h1><%= PallasTrade.t('newsletter_mailer.email_confirmation.subject') %></h1>
  <p class="greeting"><%= PallasTrade.t('newsletter_mailer.email_confirmation.dear_customer') %></p>
  <p><%= PallasTrade.t('newsletter_mailer.email_confirmation.instructions') %></p>
  <%= render 'pallastrade/shared/mailer_button', url: @confirm_email_url, label: PallasTrade.t('newsletter_mailer.email_confirmation.verify_email_address_link') %>
  <p class="sub">
    <%= PallasTrade.t('newsletter_mailer.email_confirmation.message_copy_link') %>
    <br>
    <%= link_to @confirm_email_url, @confirm_email_url %>
  </p>
  <p class="sub"><%= PallasTrade.t('newsletter_mailer.email_confirmation.ignore_disclaimer') %></p>
<% end %>
