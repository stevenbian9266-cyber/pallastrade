<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= html_dir %>">
  <head>
    <%= render "pallastrade/admin/shared/head" %>
    <%= render "pallastrade/admin/shared/custom_head" %>
  </head>

  <body class="admin min-h-screen <%= controller_name %> <%= action_name %>"
    data-controller="admin sidebar drawer dialog"
    data-action="keydown.ctrl+s->admin#save keydown.meta+s->admin#save"
  >
    <%= render_admin_partials(:body_start_partials) %>

    <%= render "pallastrade/admin/shared/header" %>
    <%= render "pallastrade/admin/shared/sidebar" %>
    <main id="content" data-controller="export-dialog">
      <%= render "pallastrade/admin/shared/content_header" %>
      <%= render "pallastrade/admin/shared/page_tabs" %>
      <%= render "pallastrade/admin/shared/page_alerts" %>
      <div class="container mx-auto px-4 max-w-screen-xl">
        <%= yield %>
      </div>
      <%= render "pallastrade/admin/shared/footer" %>
      <%= render 'pallastrade/admin/shared/drawer' %>
      <%= render "pallastrade/admin/shared/dialog" %>
    </main>
    <%= render "pallastrade/admin/shared/alerts" %>
    <%= render "pallastrade/admin/shared/turbo_confirm_dialog" %>

    <%= render_admin_partials(:body_end_partials) %>
  </body>
</html>
