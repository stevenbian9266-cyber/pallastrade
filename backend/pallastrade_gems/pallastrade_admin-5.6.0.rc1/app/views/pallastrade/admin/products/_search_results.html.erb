<div id="products_search_results" class="search-results">
  <% if products.any? %>
    <%= render collection: products, partial: 'pallastrade/admin/products/search_result', as: :product, cached: pallastrade_base_cache_scope %>
  <% else %>
    <p class="text-gray-600 text-center py-12">
      <%= PallasTrade.t('admin.products.search_results.no_products') %>
    </p>
  <% end %>
</div>
