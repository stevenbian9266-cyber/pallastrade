<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">
      <%= PallasTrade.t(:gift_card_batch) %>
    </h5>
  </div>

  <div class="card-body">
    <%= f.pallastrade_text_field :prefix, disabled: f.object.persisted?, label: PallasTrade.t('admin.gift_card_batches.prefix'), autofocus: true %>
    <%= f.pallastrade_money_field :amount, currency: f.object.currency, required: true, disabled: f.object.persisted? %>
    <%= f.pallastrade_select :currency, options_for_select(supported_currency_options, f.object.currency), { label: PallasTrade.t(:currency), autocomplete: true } %>
    <%= f.pallastrade_number_field :codes_count, required: true, min: 1, max: PallasTrade::Config[:gift_card_batch_limit], label: PallasTrade.t('admin.gift_card_batches.codes_count') %>
    <%= f.pallastrade_date_field :expires_at, disabled: f.object.persisted?, help: PallasTrade.t('admin.gift_card_batches.expires_at_help') %>
  </div>
</div>
