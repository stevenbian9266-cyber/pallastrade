<%= turbo_frame_tag :dialog do %>
  <%= form_for :digital_asset, url: PallasTrade.admin_product_digital_assets_path(@product) do |f| %>
    <%= dialog_header(PallasTrade.t(:new_digital_asset)) %>
    <div class="dialog-body">
      <%= render "pallastrade/admin/digital_assets/form", f: f %>
    </div>
    <div class="dialog-footer">
      <%= dialog_discard_button %>
      <%= turbo_save_button_tag PallasTrade.t("actions.save"), data: { turbo_frame: :_top } %>
    </div>
  <% end %>
<% end %>
