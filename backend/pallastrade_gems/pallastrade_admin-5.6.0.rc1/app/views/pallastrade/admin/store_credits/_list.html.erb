<% if @collection.any? %>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <th scope="col"><%= PallasTrade.t(:currency) %></th>
        <th scope="col"><%= PallasTrade.t('store_credit.allocated') %></th>
        <th scope="col"><%= PallasTrade.t('store_credit.authorized') %></th>
        <th scope="col"><%= PallasTrade.t('store_credit.captured') %></th>
        <th scope="col"><%= PallasTrade.t('store_credit.remaining') %></th>
        <th scope="col"><%= PallasTrade.t(:created_by) %></th>
        <th scope="col"><%= PallasTrade.t(:issued_on) %></th>
      </thead>
      <tbody>
        <%= render partial: 'pallastrade/admin/store_credits/store_credit', collection: @collection, as: :store_credit, cached: pallastrade_base_cache_scope %>
      </tbody>
    </table>
  </div>
  <%= render partial: 'pallastrade/admin/shared/index_table_options', locals: { collection: @collection } %>
<% else %>
  <%= render 'pallastrade/admin/shared/no_resource_found', model_class: PallasTrade::StoreCredit, new_object_url: PallasTrade.new_admin_user_store_credit_path(@user) %>
<% end %>