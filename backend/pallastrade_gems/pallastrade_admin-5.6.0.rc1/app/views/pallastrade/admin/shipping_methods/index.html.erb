<% content_for :page_title do %>
  <%= PallasTrade.t(:shipping) %>
<% end %>

<% content_for :page_actions do %>
  <%= render_admin_partials(:shipping_methods_actions_partials) %>
  <%= link_to_with_icon 'plus', PallasTrade.t(:new_shipping_method), new_object_url, class: "btn btn-primary" if can?(:create, PallasTrade::ShippingMethod) %>
<% end %>

<%= render partial: 'pallastrade/admin/shared/shipping_nav' %>

<% content_for :page_alerts do %>
  <div class="alert alert-info">
    <%= PallasTrade.t('admin.shipping_methods.checkout_info') %>
  </div>
<% end %>

<%= render_admin_partials(:shipping_methods_header_partials) %>

<%= render_table @collection, :shipping_methods %>
