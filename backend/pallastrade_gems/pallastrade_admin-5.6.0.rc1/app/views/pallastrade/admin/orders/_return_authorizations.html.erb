<% if @return_authorizations.exists? && can?(:read, PallasTrade::ReturnAuthorization) %>
  <div class="card mb-6">
    <div class="card-header justify-between">
      <h5 class="card-title">
        <%= PallasTrade.t(:return_authorizations) %></h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table">
          <thead class="border-b">
            <tr>
              <th scope="col"><%= PallasTrade.t(:rma_number) %></th>
              <th scope="col"><%= PallasTrade.t(:status) %></th>
              <th scope="col"><%= PallasTrade.t(:pre_tax_total) %></th>
              <th scope="col"><%= "#{PallasTrade.t("date")}/#{PallasTrade.t("time")}" %></th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "pallastrade/admin/orders/return_authorizations/return_authorization",
            collection: @return_authorizations,
            cached: ->(r) { [pallastrade_base_cache_key, r.cache_key_with_version, r.return_items.maximum(:updated_at)] } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
