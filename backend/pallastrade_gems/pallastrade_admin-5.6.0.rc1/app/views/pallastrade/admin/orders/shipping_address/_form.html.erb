<%= render 'pallastrade/admin/shared/error_messages', target: address %>
<%= render 'pallastrade/addresses/form',
                  address_name: 'address',
                  address_form: f,
                  address_type: 'shipping',
                  address: address %>
<% if @order.user.present? && @order.user.addresses.many? %>
  <div>
    <div class="w-full text-center mb-2"><%= PallasTrade.t(:or_select_other_address) %></div>
    <%= label_tag :shipping_address_id, PallasTrade.t(:existing_address), class: 'sr-only' %>
    <%= select_tag :shipping_address_id,
                   options_for_select(@order.user.addresses.map { |a| [a.to_s.gsub('<br/>', ", "), a.to_param]}),
                   { include_blank: PallasTrade.t(:select_existing_address), class: "form-select", data: { action: 'auto-submit#submit' } } %>
  </div>
<% end %>
