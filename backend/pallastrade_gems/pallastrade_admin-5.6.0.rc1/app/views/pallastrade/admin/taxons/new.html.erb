<% content_for :page_title do %>
  <%= page_header_back_button PallasTrade.admin_taxonomy_path(@taxonomy) %>
  <%= PallasTrade.t(:new_taxon) %>
<% end %>

<%= render partial: 'pallastrade/admin/shared/error_messages', locals: { target: @taxon } %>

<%= form_for @taxon, as: :taxon, url: PallasTrade.admin_taxonomy_taxons_path do |f| %>
  <%= render 'form', f: f %>

  <%= render 'pallastrade/admin/shared/new_resource_links' %>
<% end %>
