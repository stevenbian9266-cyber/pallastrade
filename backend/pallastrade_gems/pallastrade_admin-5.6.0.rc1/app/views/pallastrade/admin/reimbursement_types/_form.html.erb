<div class="card mb-6">
  <div class="card-body">
    <%= f.pallastrade_text_field :name, autofocus: f.object.new_record?, required: true %>

    <%= f.pallastrade_select :type,
              options_for_select(
                PallasTrade::ReimbursementType::KINDS.map do |kind|
                  [kind.demodulize.titleize, kind]
                end,
                f.object.type
              ),
              { include_blank: false, label: PallasTrade.t(:type), autocomplete: true } %>

    <%= f.pallastrade_check_box :active, label: PallasTrade.t(:active) %>

    <%= f.pallastrade_check_box :mutable, label: PallasTrade.t(:mutable) %>
  </div>
</div>
