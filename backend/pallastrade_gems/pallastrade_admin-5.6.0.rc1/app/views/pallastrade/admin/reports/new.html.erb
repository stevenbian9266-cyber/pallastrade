<% content_for :page_title do %>
  <%= page_header_back_button PallasTrade.admin_reports_path  %>
  <%= PallasTrade.t("report_names.#{params[:type]}") %>
<% end %>

<%= content_for :page_actions do %>
  <%= form_for @report, url: PallasTrade.admin_reports_path, as: :report, html: { class: 'inline-block' } do |f| %>
    <%= f.hidden_field :type %>
    <%= f.hidden_field :date_from %>
    <%= f.hidden_field :date_to %>
    <%= f.hidden_field :currency %>

    <% if defined?(PallasTrade::Vendor) %>
      <%= f.hidden_field :vendor_id %>
    <% end %>

    <button class="btn btn-primary" data-controller="tooltip">
      <%= icon('table-export') %>
      <%= PallasTrade.t(:export) %>
      <%= tooltip(PallasTrade.t('admin.export_report')) %>
    </button>
  <% end %>
<% end if can?(:create, PallasTrade::Export) %>

<div class="mb-2">
  <%= form_tag PallasTrade.new_admin_report_path, method: :get, data: { controller: 'auto-submit' } do %>
    <%= hidden_field_tag :type, params[:type] %>

    <div class="flex gap-2">
      <%= render 'pallastrade/admin/shared/calendar_range_picker',
        date_from_value: params[:date_from] || 1.month.ago.in_time_zone(current_timezone).beginning_of_day,
        date_to_value: params[:date_to] || Time.current.in_time_zone(current_timezone).end_of_day %>

      <div class="form-group">
        <%= select_tag :currency,
          options_for_select(current_store.supported_currencies_list, @report.currency),
          class: 'form-select bg-transparent pr-8!',
          data: { action: 'change->auto-submit#submit' } %>
      </div>

      <% if defined?(PallasTrade::Vendor) %>
        <div class="form-group">
          <%= select_tag :vendor_id,
            options_for_select(PallasTrade::Vendor.pluck(:name, :id), @report.vendor_id),
            include_blank: "-- #{PallasTrade.t(:select_vendor)} --",
            class: 'custom-select bg-transparent',
            data: { action: 'change->auto-submit#submit' } %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= render @report %>