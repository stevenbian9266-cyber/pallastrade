<%= render layout: 'pallastrade/shared/mailer_hero' do %>
  <h1><%= PallasTrade.t('export_mailer.greeting', user_name: @export.user&.first_name) %></h1>
  <p><%= PallasTrade.t('export_mailer.export_done.message') %></p>
  <% if @export.results_url.present? %>
    <%= render 'pallastrade/shared/mailer_button', url: @export.results_url, label: @export.attachment.filename %>
  <% end %>
<% end %>
