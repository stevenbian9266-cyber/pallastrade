<%= render layout: 'pallastrade/shared/mailer_hero' do %>
  <h1><%= PallasTrade.t('admin_user_mailer.confirmation_email.action') %></h1>
  <p class="greeting"><%= PallasTrade.t('admin_user_mailer.confirmation_email.greeting', name: @user.first_name.presence || @user.email) %></p>
  <p><%= PallasTrade.t('admin_user_mailer.confirmation_email.instructions', store_name: @current_store.name) %></p>
  <%= render 'pallastrade/shared/mailer_button', url: @confirmation_url, label: PallasTrade.t('admin_user_mailer.confirmation_email.action') %>
  <p class="sub"><%= PallasTrade.t('admin_user_mailer.confirmation_email.ignore_notice') %></p>
<% end %>
