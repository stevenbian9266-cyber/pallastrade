<%= render 'pallastrade/admin/shared/developers_nav' %>

<%= content_for(:title, PallasTrade.t('admin.oauth_applications.list')) %>

<% content_for :page_actions do %>
  <%= render_admin_partials(:oauth_applications_actions_partials) %>
  <%= link_to_with_icon 'plus', PallasTrade.t('admin.oauth_applications.new'), new_object_url, class: "btn btn-primary" if can? :create, PallasTrade::OauthApplication %>
<% end %>

<%= content_for :page_alerts do %>
  <div class="alert alert-info">
    <p>
      API v2 is retired from the public PallasTrade contract.
      Use the <%= external_link_to 'v2 to v3 migration guide', 'https://pallastrade.cn/docs/api-reference/store-api/migrating-from-storefront-api-v2' %>
      and the <%= external_link_to 'API version policy', 'https://pallastrade.cn/docs/api-reference/version-policy' %>.
    </p>
  </div>
<% end %>

<%= render_admin_partials(:oauth_applications_header_partials) %>

<%= render 'pallastrade/admin/shared/index_table' %>
