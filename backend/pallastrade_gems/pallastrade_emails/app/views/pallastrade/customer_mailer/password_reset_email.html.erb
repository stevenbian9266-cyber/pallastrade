<%= render layout: 'pallastrade/shared/mailer_hero' do %>
  <h1><%= PallasTrade.t('customer_mailer.password_reset_email.action') %></h1>
  <p class="greeting"><%= PallasTrade.t('customer_mailer.password_reset_email.greeting', name: @user.first_name.presence || @user.email) %></p>
  <p><%= PallasTrade.t('customer_mailer.password_reset_email.instructions') %></p>
  <% if @reset_url %>
    <%= render 'pallastrade/shared/mailer_button', url: @reset_url, label: PallasTrade.t('customer_mailer.password_reset_email.action') %>
  <% end %>
  <p class="sub"><%= PallasTrade.t('customer_mailer.password_reset_email.expiry_notice') %></p>
  <p class="sub"><%= PallasTrade.t('customer_mailer.password_reset_email.ignore_notice') %></p>
<% end %>
