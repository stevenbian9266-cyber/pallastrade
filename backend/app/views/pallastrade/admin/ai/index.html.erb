<% content_for :page_title do %>
  <%= PallasTrade.t(:ai_tools) %>
<% end %>

<div class="space-y-6">
  <% unless PallasTradeAI::Config.system_enabled? %>
    <div class="p-4 bg-yellow-50 border border-yellow-200 rounded">
      <p class="text-yellow-800"><%= PallasTrade.t('admin.ai.overview_warning') %></p>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded shadow p-4">
      <h3 class="text-sm text-gray-500"><%= PallasTrade.t(:providers) %></h3>
      <p class="text-2xl font-bold"><%= @provider_count %></p>
      <%= link_to PallasTrade.t(:manage), PallasTrade.admin_ai_providers_path, class: "text-sm text-blue-600" %>
    </div>

    <div class="bg-white rounded shadow p-4">
      <h3 class="text-sm text-gray-500"><%= PallasTrade.t(:models) %></h3>
      <p class="text-2xl font-bold"><%= @active_model_count %> / <%= @model_count %></p>
      <%= link_to PallasTrade.t(:manage), PallasTrade.admin_ai_models_path, class: "text-sm text-blue-600" %>
    </div>

    <div class="bg-white rounded shadow p-4">
      <h3 class="text-sm text-gray-500"><%= PallasTrade.t(:capabilities) %></h3>
      <p class="text-2xl font-bold"><%= @cap_count %></p>
      <%= link_to PallasTrade.t(:manage), PallasTrade.admin_ai_capabilities_path, class: "text-sm text-blue-600" %>
    </div>

    <div class="bg-white rounded shadow p-4">
      <h3 class="text-sm text-gray-500"><%= PallasTrade.t(:runs) %></h3>
      <p class="text-2xl font-bold"><%= @run_count %></p>
      <%= link_to PallasTrade.t(:view), PallasTrade.admin_ai_runs_path, class: "text-sm text-blue-600" %>
    </div>
  </div>

  <div class="bg-white rounded shadow p-6">
    <h2 class="text-lg font-semibold mb-4"><%= PallasTrade.t(:settings) %></h2>
    <%= form_tag PallasTrade.admin_ai_update_settings_path, method: :patch do %>
      <label class="flex items-center gap-3">
        <%= check_box_tag :active, '1', @setting&.active?, class: 'rounded' %>
        <span class="text-sm font-medium"><%= PallasTrade.t('admin.ai.store_switch') %></span>
      </label>
      <%= submit_tag PallasTrade.t(:save), class: "mt-3 btn btn-primary" %>
    <% end %>
  </div>
</div>
