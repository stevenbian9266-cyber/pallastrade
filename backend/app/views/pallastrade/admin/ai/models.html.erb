<% content_for :page_title do %>
  <%= page_header_back_button(PallasTrade.admin_ai_path) %>
  <%= PallasTrade.t(:models) %> &middot; <%= PallasTrade.t(:ai_tools) %>
<% end %>

<div class="space-y-4">
  <table class="w-full bg-white rounded shadow">
    <thead>
      <tr class="border-b text-left">
        <th class="p-3"><%= PallasTrade.t('ai.model.name') %></th>
        <th class="p-3"><%= PallasTrade.t('ai.model.provider') %></th>
        <th class="p-3"><%= PallasTrade.t('ai.model.model_id') %></th>
        <th class="p-3"><%= PallasTrade.t('ai.model.kind') %></th>
        <th class="p-3"><%= PallasTrade.t('ai.model.active') %></th>
        <th class="p-3"><%= PallasTrade.t('ai.model.action') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'pallastrade/admin/ai/model_row', collection: @models, as: :model %>
    </tbody>
  </table>
  <% if @models.empty? %>
    <div class="bg-white rounded shadow p-6 text-center">
      <p class="text-gray-400"><%= PallasTrade.t('ai.model.empty') %></p>
      <%= link_to PallasTrade.t('ai.provider.test_connection'), PallasTrade.admin_ai_providers_path, class: 'btn btn-sm btn-primary mt-2' %>
    </div>
  <% end %>
</div>
