<% content_for :page_title do %>
  <%= page_header_back_button(PallasTrade.admin_ai_path) %>
  <%= PallasTrade.t(:capabilities) %> &middot; <%= PallasTrade.t(:ai_tools) %>
<% end %>

<div class="space-y-4">
  <% if @capabilities.empty? %>
    <div class="bg-white rounded shadow p-12 text-center text-gray-400">
      <p class="text-lg"><%= PallasTrade.t('ai.capability.empty') %></p>
      <p class="text-sm mt-2"><%= PallasTrade.t('ai.capability.empty_hint') %></p>
    </div>
  <% else %>
    <% @capabilities.each do |cap| %>
      <% entry = cap[:entry]; setting = cap[:setting] %>
      <div class="bg-white rounded shadow p-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold"><%= entry.display_name %></h2>
            <p class="text-sm text-gray-500 font-mono"><%= entry.key %></p>
          </div>
          <%= form_tag PallasTrade.admin_ai_update_capability_path(capability_key: entry.key), method: :patch do %>
            <%= hidden_field_tag :active, !setting&.active? %>
            <%= submit_tag setting&.active? ? PallasTrade.t('ai.capability.disable') : PallasTrade.t('ai.capability.enable'), class: setting&.active? ? 'btn btn-sm bg-red-500 text-white' : 'btn btn-sm bg-green-500 text-white' %>
          <% end %>
        </div>
        <div class="mt-2 text-sm text-gray-600">
          <p><%= entry.description %></p>
          <div class="flex gap-4 mt-1">
            <span>v<%= entry.version %></span>
            <span>Mode: <%= entry.execution_mode %></span>
            <span>Classification: <%= entry.data_classification %></span>
          </div>
        </div>
        <% if setting.present? %>
          <div class="mt-3 text-xs text-gray-500">
            Model: <%= setting.primary_model&.name || PallasTrade.t('ai.capability.not_set') %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
