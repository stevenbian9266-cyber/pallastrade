<% content_for :page_title do %>
  <%= page_header_back_button(PallasTrade.admin_ai_path) %>
  <%= PallasTrade.t(:providers) %> &middot; <%= PallasTrade.t(:ai_tools) %>
<% end %>

<div class="space-y-4">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <% @providers.each do |provider| %>
      <%
        secret = PallasTrade::AI::ProviderSecret.find_by(provider: provider)
        key_ok = secret&.configured?
        # Connection verification is not yet persisted (no verification_status
        # column); treat as unverified so badges degrade gracefully.
        verified = false

        badge_class, badge_text = if provider.active? && key_ok && verified
          ['badge-active', PallasTrade.t('ai.provider.active_label')]
        elsif provider.active? && key_ok && !verified
          ['badge-warning', PallasTrade.t('ai.provider.active_untested')]
        elsif provider.active? && !key_ok
          ['badge-warning', PallasTrade.t('ai.provider.active_no_key')]
        else
          ['badge-inactive', PallasTrade.t('ai.provider.inactive_label')]
        end
      %>
      <%= link_to PallasTrade.admin_ai_provider_path(provider),
            class: 'block bg-white rounded border border-gray-200 shadow-sm p-6 hover:bg-gray-50 hover:border-gray-400 transition-colors no-underline' do %>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold"><%= provider.name %></h2>
          <span class="badge <%= badge_class %>"><%= badge_text %></span>
        </div>

        <dl class="space-y-2 text-sm">
          <dt class="text-gray-500"><%= PallasTrade.t('ai.provider.key') %></dt>
          <dd class="font-mono">
            <% if secret&.configured? %>
              <span class="text-green-600"><%= secret.key_hint_display %></span>
              <span class="text-gray-400">(<%= PallasTrade.t('ai.provider.configured') %>)</span>
            <% else %>
              <span class="text-red-600"><%= PallasTrade.t('ai.provider.key_not_configured') %></span>
            <% end %>
          </dd>

          <dt class="text-gray-500"><%= PallasTrade.t('ai.provider.connection') %></dt>
          <dd><span class="text-gray-400"><%= PallasTrade.t('ai.provider.never_tested') %></span></dd>

          <dt class="text-gray-500"><%= PallasTrade.t('ai.models') %></dt>
          <dd><%= PallasTrade.t('ai.provider.models_count', total: PallasTrade::AI::Model.where(provider: provider).count, active: PallasTrade::AI::Model.where(provider: provider, active: true).count) %></dd>
        </dl>

        <div class="mt-4 flex gap-2" onclick="event.stopPropagation()">
          <%= button_to PallasTrade.t('ai.provider.test_connection'),
                PallasTrade.admin_ai_test_connection_path(provider),
                method: :post,
                class: 'btn btn-sm btn-secondary',
                form: { class: 'inline' } %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
