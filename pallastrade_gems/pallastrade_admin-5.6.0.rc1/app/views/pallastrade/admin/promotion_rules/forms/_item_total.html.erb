<div class="grid grid-cols-12 gap-6 mb-6">
  <div class="col-span-6">
    <%= f.select :preferred_operator_min,
                 options_for_select(PallasTrade::Promotion::Rules::ItemTotal::OPERATORS_MIN.map{|o| [PallasTrade.t("item_total_rule.operators.#{o}"),o]}, f.object.preferred_operator_min),
                 {},
                 { class: 'form-select' } %>
  </div>
  <div class="col-span-6">
    <%= f.number_field :preferred_amount_min, class: 'form-input', required: true %>
  </div>
</div>
<div class="grid grid-cols-12 gap-6">
  <div class="col-span-6">
    <%= f.select :preferred_operator_max,
                 options_for_select(PallasTrade::Promotion::Rules::ItemTotal::OPERATORS_MAX.map{|o| [PallasTrade.t("item_total_rule.operators.#{o}"),o]}, f.object.preferred_operator_max),
                 {},
                 { class: 'form-select' } %>
  </div>
  <div class="col-span-6">
    <%= f.number_field :preferred_amount_max, class: 'form-input' %>

    <span class="form-text mt-2">
      <%= PallasTrade.t('item_total_rule.max_amount_help') %>
    </span>
  </div>
</div>