<div class="card" id="<%= dom_id(payment) %>">
  <div class="card-header flex items-center gap-2">
    <span class="badge badge-<%= payment.state %> gap-1">
      <% if payment.completed? %>
        <%= icon('check') %>
      <% elsif payment.invalid? || payment.void? || payment.failed? %>
        <%= icon('x') %>
      <% else %>
        <%= icon('progress') %>
      <% end %>
      <%= PallasTrade.t('payment_states.' + payment.state) %>
    </span>
    <% if payment.payment_method.present? && payment.payment_method.payment_icon_name.present? %>
      <%= payment_method_icon_tag(payment.payment_method.payment_icon_name) %>
    <% end %>
    <strong><%= payment.number.upcase %></strong>
    <%= pallastrade_time(payment.created_at, class: 'ms-auto text-gray-600 text-sm') %>

    <%= dropdown do %>
      <%= dropdown_toggle class: 'btn-light btn-sm px-1' do %>
        <%= icon('dots-vertical', class: 'mr-0') %>
      <% end %>
      <%= dropdown_menu do %>
        <% if payment.try(:gateway_dashboard_payment_url).present? %>
          <%= link_to_with_icon 'eye', PallasTrade.t(:details), payment.gateway_dashboard_payment_url, class: 'dropdown-item', target: '_blank' %>
        <% end %>
        <% if payment.source.is_a?(PallasTrade::StoreCredit) && payment.source.originator_type == 'PallasTrade::GiftCard' %>
          <%= link_to_with_icon 'eye', PallasTrade.t(:details), PallasTrade.admin_gift_card_path(payment.source.originator), class: 'dropdown-item' %>
        <% end %>

        <% if can?(:update, payment) && (payment.checkout? || payment.pending?) && payment.payment_method.present? %>
          <%= link_to_with_icon 'check', PallasTrade.t(:capture), PallasTrade.capture_admin_order_payment_path(@order, payment), class: 'dropdown-item', data: { turbo_method: :put, turbo_confirm: PallasTrade.t(:are_you_sure) } %>
        <% end %>
        <% if can?(:refund, @order) && payment.completed? && payment.can_credit? && payment.payment_method.present? %>
          <%= link_to_with_icon 'credit-card-refund', PallasTrade.t(:refund), PallasTrade.new_admin_order_payment_refund_path(@order, payment), class: 'dropdown-item' %>
        <% end %>
        <% if can?(:cancel, payment) && payment.pending? && payment.payment_method.present? %>
          <div class="dropdown-divider"></div>
          <%= link_to_with_icon 'cancel', PallasTrade.t(:void), PallasTrade.void_admin_order_payment_path(@order, payment), class: 'dropdown-item text-red-600 hover:bg-red-100', data: { turbo_method: :put, turbo_confirm: PallasTrade.t(:are_you_sure) } %>
        <% end %>
        <% if can?(:destroy, payment) && payment.can_be_deleted? %>
          <div class="dropdown-divider"></div>
          <%= link_to_with_icon 'trash', PallasTrade.t('actions.destroy'), PallasTrade.admin_order_payment_path(@order, payment), class: 'dropdown-item text-red-600 hover:bg-red-100', data: { turbo_method: :delete, turbo_confirm: PallasTrade.t(:are_you_sure) } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="card-body">
    <% if payment.gateway_processing_error_messages.any? %>
      <div class="alert alert-danger inline-block">
        <strong><%= PallasTrade.t(:payments_gateway_processing_errors, payment_method_name: payment.payment_method&.name) %>:</strong>
        <%= payment.gateway_processing_error_messages.join(', ') %>
      </div>
    <% end %>

    <div class="flex">
      <div class="w-1/2">
        <p class="mb-0.5"><%= PallasTrade.t(:amount) %>:</p>
        <strong><%= payment.display_amount %></strong>

        <p class="mb-0.5 mt-2"><%= PallasTrade.t(:payment_method) %>:</p>
        <strong><%= payment_method_name(payment) %></strong>

        <% if payment.transaction_id.present? %>
          <p class="mb-0.5 mt-2">
            <%= PallasTrade.t(:transaction_id) %>
            <%= help_bubble(PallasTrade.t(:transaction_id_help)) %>
          </p>
          <strong><%= payment.transaction_id %></strong>
        <% end %>
      </div>
      <% if payment.source.present? %>
        <div class="w-1/2">
          <p class="mb-2"><%= PallasTrade.t(:payment_source) %>:</p>
          <div class="rounded-xl bg-gray-25 border shadow-xs p-4">
            <%= render 'spree/shared/payment', payment: payment %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <% if payment.transaction_id.present? && !payment.store_credit? %>
    <div class="card-footer border-t border-dashed py-3" data-controller="reveal">
      <p class="mb-0 flex justify-between items-center">
        <span>
          <%= PallasTrade.t(:risk_analysis) %>
          &nbsp;
          <% if @order.is_risky? %>
            <span class="badge badge-warning"><%= icon('shield-off') %> <%= PallasTrade.t(:risky) %></span>
          <% else %>
            <span class="text-green-700"><%= icon('shield-check-filled') %> <%= PallasTrade.t(:not_risky) %></span>
          <% end %>
        </span>
        <button type="button" class="btn btn-light btn-sm" data-action="click->reveal#toggle">
          <%= PallasTrade.t(:show_details) %>
          <%= icon('selector', class: 'mr-0 ml-0.5') %>
        </button>
      </p>
      <%= render 'spree/admin/orders/risk_analysis', payment: payment %>
    </div>
  <% end %>
</div>