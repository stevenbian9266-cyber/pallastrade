<% if @refunds.any? %>
  <div class="card mb-6">
    <div class="card-header flex items-center">
      <h5 class="card-title">
        <%= icon('credit-card-refund', class: 'mr-2') %>
        <%= PallasTrade.t(:refunds) %>
      </h5>
      <span class="badge badge-info ml-2"><%= @refunds.count %></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-condensed" id='refunds' data-order-id='<%= @order.number %>'>
          <thead>
            <tr data-hook="refunds_header" class="border-b">
              <th scope="col"><%= PallasTrade.t(:amount) %></th>
              <th scope="col"><%= PallasTrade.t(:status) %></th>
              <th scope="col"><%= PallasTrade.t(:reason) %></th>
              <th scope="col"><%= "#{PallasTrade.t('date')}/#{PallasTrade.t('time')}" %></th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @refunds.each do |refund| %>
              <tr id="<%= pallastrade_dom_id(refund) %>">
                <td class="amount"><%= refund.display_amount %></td>
                <td>
                  <% if refund.transaction_id.present? %>
                    <span class="badge badge-success"><%= icon('check') %><%= PallasTrade.t('state_machine_states.completed') %></span>
                  <% else %>
                    <span class="badge badge-warning"><%= icon('clock') %><%= PallasTrade.t('state_machine_states.pending') %></span>
                  <% end %>
                </td>
                <td><%= truncate(refund.reason.name, length: 100) %></td>
                <td><%= pallastrade_time(refund.created_at) %></td>
                <% if refund.editable? && can?(:edit, refund) %>
                  <td class="actions">
                    <%= link_to_with_icon('edit', PallasTrade.t(:edit), PallasTrade.edit_admin_order_payment_refund_path(refund.payment.order, refund.payment, refund), no_text: true, data: { turbo_frame: 'dialog', action: 'dialog#open' }, class: "btn btn-light btn-sm") if can?(:edit, refund) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>