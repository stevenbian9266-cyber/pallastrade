<%= turbo_frame_tag :dialog do %>
  <div>
    <%= dialog_header(PallasTrade.t(:add_coupon_code)) %>
    <%= form_with url: PallasTrade.admin_order_order_promotions_path(@order) do |f| %>
      <div class="dialog-body">
        <%= f.pallastrade_text_field :coupon_code,
                               placeholder: PallasTrade.t(:add_coupon_code),
                               autofocus: true %>
      </div>
      <div class="dialog-footer">
        <%= turbo_save_button_tag PallasTrade.t(:apply) %>
      </div>
    <% end %>
  </div>
<% end %>
