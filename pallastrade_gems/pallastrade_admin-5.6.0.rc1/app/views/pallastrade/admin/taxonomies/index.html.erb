<% content_for(:page_title) do %>
  <%= PallasTrade.t(:taxonomies) %>
<% end %>

<% content_for :page_actions do %>
  <%= render_admin_partials(:taxonomies_actions_partials) %>
  <%= link_to_with_icon 'plus', PallasTrade.t(:new_taxonomy), new_object_url, class: "btn btn-primary" if can?(:create, PallasTrade::Taxonomy) %>
<% end %>

<%= render_admin_partials(:taxonomies_header_partials) %>

<%= render_table @collection, :taxonomies, sortable: true %>
