<div class="card mb-6">
  <div class="card-body" data-controller="slug-form">
    <%= f.pallastrade_text_field :name,
                           autofocus: f.object.new_record?,
                           required: true,
                           data: { slug_form_target: :name, action: 'slug-form#updateUrlFromName' } %>
    <%= f.pallastrade_text_field :code,
                           required: true,
                           hint: PallasTrade.t('admin.channels.code_hint'),
                           data: { slug_form_target: :url } %>
    <%= f.pallastrade_check_box :active, label: PallasTrade.t(:active) %>
    <%= f.pallastrade_check_box :default, label: PallasTrade.t('admin.channels.default'), hint: PallasTrade.t('admin.channels.default_hint') %>
    <%= f.pallastrade_select :preferred_order_routing_strategy,
        options_for_select(channel_order_routing_strategy_options, f.object.preferred_order_routing_strategy),
        { label: PallasTrade.t('admin.channels.order_routing_strategy'),
          help_bubble: PallasTrade.t('admin.channels.order_routing_strategy_hint'),
          include_blank: PallasTrade.t('admin.channels.order_routing_strategy_inherit') } %>
    <%= f.pallastrade_select :preferred_storefront_access,
        options_for_select(channel_storefront_access_options, f.object.preferred_storefront_access),
        { label: PallasTrade.t('admin.channels.storefront_access'),
          help_bubble: PallasTrade.t('admin.channels.storefront_access_hint'),
          include_blank: PallasTrade.t('admin.channels.storefront_access_inherit') } %>
    <%= f.pallastrade_select :preferred_guest_checkout,
        options_for_select(channel_guest_checkout_options, f.object.preferred_guest_checkout&.to_s || ''),
        { label: PallasTrade.t('admin.channels.guest_checkout'),
          help_bubble: PallasTrade.t('admin.channels.guest_checkout_hint'),
          include_blank: PallasTrade.t('admin.channels.guest_checkout_inherit') } %>
  </div>
</div>
