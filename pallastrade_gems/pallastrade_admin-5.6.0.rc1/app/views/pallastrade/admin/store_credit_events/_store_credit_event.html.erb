<tr id="<%= pallastrade_dom_id(store_credit_event) %>">
  <td class="w-15">
    <span class="badge badge-<%= store_credit_event.action %>">
      <%= store_credit_event.display_action %>
    </span>
  </td>
  <td class="w-15">
    <%= store_credit_event.display_amount %>
  </td>
  <td class="w-30">
    <% if defined?(PallasTrade::GiftCard) && store_credit_event.originator.is_a?(PallasTrade::GiftCard) %>
      <%= link_to store_credit_event.originator.code.upcase, PallasTrade.admin_gift_card_path(store_credit_event.originator) %>
    <% elsif store_credit_event.originator.is_a?(PallasTrade.admin_user_class) %>
      <%= link_to store_credit_event.originator.email, PallasTrade.admin_admin_user_path(store_credit_event.originator) %>
    <% end %>
  </td>
  <td class="w-20">
    <% if store_credit_event.order %>
      <%= link_to store_credit_event.order.number, PallasTrade.edit_admin_order_path(store_credit_event.order) %>
    <% else %>
      <span class="text-gray-600">
        <%= PallasTrade.t(:not_available) %>
      </span>
    <% end %>
  </td>
  <td class="w-20">
    <%= pallastrade_date(store_credit_event.created_at) %>
  </td>
</tr>