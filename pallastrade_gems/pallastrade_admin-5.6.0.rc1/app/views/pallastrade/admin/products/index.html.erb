<% content_for :page_title do %>
  <%= PallasTrade.t(:products) %>
<% end %>

<% content_for :page_actions do %>
  <%= render_admin_partials(:products_actions_partials) %>
  <%= link_to_with_icon 'table-import', PallasTrade.t(:import), PallasTrade.new_admin_import_path(type: 'PallasTrade::Imports::Products'), class: 'btn btn-light', data: { action: 'drawer#open',turbo_frame: :drawer } if can?(:create, PallasTrade::Import) %>
  <%= link_to_export_modal %>
  <%= link_to_with_icon 'plus', PallasTrade.t(:new_product), new_object_url, class: 'btn btn-primary' if can?(:create, PallasTrade::Product) %>
<% end %>

<%= render_admin_partials(:products_header_partials) %>

<%= render_table @collection, :products, bulk_operations: true, export_type: PallasTrade::Exports::Products %>

<p class="documentation-link-container">
  <%= external_link_to PallasTrade.t('admin.products.learn_more'), 'https://spreecommerce.org/docs/user/manage-products' %>
</p>