<div id="<%= pallastrade_dom_id(asset) %>" class="media-form__image" data-sortable-update-url="<%= PallasTrade.admin_asset_path(asset) %>">
  <div class="custom-control form-checkbox hidden">
    <%= check_box_tag "ids[]", asset.id, false, class: "custom-control-input", id: "#{asset.id}-checkbox", data: { media_form_target: "checkbox", action: 'media-form#showDeleteButton' } %>
    <label class="custom-control-label" for="<%= asset.id %>-checkbox"><span></span></label>
  </div>
  <div class="move-handle text-center hidden ms-auto">
    <button class="btn btn-light btn-sm px-1"><%= icon('grip-vertical', class: 'mr-0') %></button>
  </div>

  <%= link_to PallasTrade.edit_admin_asset_path(asset), data: { turbo_frame: 'drawer', action: 'drawer#open' } do %>
    <%= pallastrade_image_tag(asset.attachment, width: 200, height: 200, alt: asset.alt, class: 'w-full block h-full absolute') %>
  <% end %>
</div>
