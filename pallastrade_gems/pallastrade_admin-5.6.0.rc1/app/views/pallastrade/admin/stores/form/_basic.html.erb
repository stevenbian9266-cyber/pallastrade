<%= content_for(:page_title) do %>
  <%= PallasTrade.t(:store_details) %>
<% end %>


<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t(:name) %> & <%= PallasTrade.t(:logo) %></h5>
  </div>
  <div class="card-body">
    <p class="text-gray-600">
      <%= PallasTrade.t(:store_name_help) %>
    </p>
    <%= f.pallastrade_text_field :name, required: true, autofocus: f.object.new_record? %>

    <%= f.pallastrade_file_field :logo, width: 240, height: 240, crop: true, help_bubble: PallasTrade.t('admin.store_form.logo_help') %>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t(:currencies) %> & <%= PallasTrade.t(:translations) %></h5>
  </div>
  <div class="card-body">
    <div class="alert alert-info w-full mb-0">
      <span>
        <%= PallasTrade.t('admin.store_form.currencies_managed_by_markets_html', markets_link: link_to(PallasTrade.t('admin.markets.list'), PallasTrade.admin_markets_path)) %>
      </span>
    </div>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t(:standards_and_formats) %></h5>
  </div>
  <div class="card-body">
    <p class="text-gray-600 mb-3">
      <%= PallasTrade.t(:standards_and_formats_help) %>
    </p>
    <%= f.pallastrade_select :preferred_admin_locale,
        options_from_collection_for_select(all_locales_options, :last, :first, @store.preferred_admin_locale || I18n.default_locale),
        { label: PallasTrade.t(:admin_locale), help_bubble: PallasTrade.t(:admin_locale_help), autocomplete: true } %>
    <div class="form-group mb-6">
      <%= label_tag :preferred_timezone, raw(PallasTrade.t(:timezone) + required_span_tag) %>
      <%= time_zone_select :store, :preferred_timezone, nil, {}, { data: { controller: 'autocomplete-select' } } %>
    </div>
    <div data-controller="unit-system">
      <%= f.pallastrade_select :preferred_unit_system, options_for_select(unit_systems, @store.preferred_unit_system), { label: PallasTrade.t(:unit_system), help_bubble: PallasTrade.t(:unit_system_help) }, { data: { unit_system_target: "body", action: "change->unit-system#unitSystemHandler" } } %>
      <%= f.pallastrade_select :preferred_weight_unit, options_for_select(weight_units(@store), @store.preferred_weight_unit), { label: PallasTrade.t(:weight_unit), help_bubble: PallasTrade.t(:weight_unit_help) }, { data: { unit_system_target: "weightUnit" } } %>
    </div>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t(:phone) %> & <%= PallasTrade.t(:address) %></h5>
  </div>
  <div class="card-body">
    <%= f.pallastrade_text_field :contact_phone %>
    <%= f.pallastrade_text_area :address %>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title"><%= PallasTrade.t(:digital_assets) %></h5>
  </div>
  <div class="card-body">
    <p class="text-gray-600 mb-4">
      <%= PallasTrade.t(:digital_assets_help) %>
    </p>
    <div data-controller="reveal">
      <%= f.pallastrade_check_box :preferred_limit_digital_download_days, data: { action: 'reveal#toggle' } %>
      <div data-reveal-target="item" <% unless f.object.preferred_limit_digital_download_days %>class="hidden"<% end %>>
        <%= f.pallastrade_number_field :preferred_digital_asset_authorized_days, min: 1 %>
      </div>
    </div>
    <hr class="my-6">
    <div data-controller="reveal">
      <%= f.pallastrade_check_box :preferred_limit_digital_download_count, data: { action: 'reveal#toggle' } %>
      <div data-reveal-target="item" <% unless f.object.preferred_limit_digital_download_count %>class="hidden"<% end %>>
        <%= f.pallastrade_number_field :preferred_digital_asset_authorized_clicks, min: 1 %>
      </div>
    </div>
  </div>
</div>

<%= render_admin_partials(:store_form_partials, f: f, store: @store) %>
