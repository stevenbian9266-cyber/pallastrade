<%= render layout: 'spree/shared/mailer_hero' do %>
  <h1><%= PallasTrade.t('admin_user_mailer.password_reset_email.action') %></h1>
  <p class="greeting"><%= PallasTrade.t('admin_user_mailer.password_reset_email.greeting', name: @user.first_name.presence || @user.email) %></p>
  <p><%= PallasTrade.t('admin_user_mailer.password_reset_email.instructions', store_name: @current_store.name) %></p>
  <%= render 'spree/shared/mailer_button', url: @reset_url, label: PallasTrade.t('admin_user_mailer.password_reset_email.action') %>
  <p class="sub"><%= PallasTrade.t('admin_user_mailer.password_reset_email.expiry_notice') %></p>
  <p class="sub"><%= PallasTrade.t('admin_user_mailer.password_reset_email.ignore_notice') %></p>
<% end %>
